<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.factory.check.mapper.MpCheckItemRecordMapper">
    <resultMap type="com.zlt.aps.monthplan.api.domain.entity.MpCheckItemRecord" id="MpCheckItemRecordResult">
        <result property="id" column="ID"/>
        <result property="year" column="YEAR"/>
        <result property="month" column="MONTH"/>
        <result property="factoryCode" column="FACTORY_CODE"/>
        <result property="productTypeCode" column="PRODUCT_TYPE_CODE"/>
        <result property="monthPlanVersion" column="MONTH_PLAN_VERSION"/>
        <result property="checkItem" column="CHECK_ITEM"/>
        <result property="checkContent" column="CHECK_CONTENT"/>
        <result property="createBy" column="CREATE_BY"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="updateBy" column="UPDATE_BY"/>
        <result property="updateTime" column="UPDATE_TIME"/>
        <result property="isDelete" column="IS_DELETE"/>
        <result property="remark" column="REMARK"/>
    </resultMap>


    <sql id="selectMpCheckItemRecordVo">
        SELECT ID, YEAR, MONTH, FACTORY_CODE, PRODUCT_TYPE_CODE, MONTH_PLAN_VERSION, CHECK_ITEM, CHECK_CONTENT, CREATE_BY, CREATE_TIME, UPDATE_BY, UPDATE_TIME, IS_DELETE, REMARK FROM T_MP_CHECK_ITEM_RECORD
    </sql>

    <select id="selectMpCheckItemRecordList" parameterType="com.zlt.aps.monthplan.api.domain.entity.MpCheckItemRecord" resultMap="MpCheckItemRecordResult">
        <include refid="selectMpCheckItemRecordVo"/>
        WHERE IS_DELETE = 0
        <if test="year != null "> AND YEAR = #{year}</if>
        <if test="month != null "> AND MONTH = #{month}</if>
        <if test="factoryCode != null  and factoryCode != ''"> AND FACTORY_CODE = #{factoryCode}</if>
        <if test="productTypeCode != null  and productTypeCode != ''"> AND PRODUCT_TYPE_CODE = #{productTypeCode}</if>
        <if test="monthPlanVersion != null  and monthPlanVersion != ''"> AND MONTH_PLAN_VERSION = #{monthPlanVersion}</if>
        <if test="checkItem != null  and checkItem != ''"> AND CHECK_ITEM = #{checkItem}</if>
        <if test="checkContent != null  and checkContent != ''"> AND CHECK_CONTENT = #{checkContent}</if>
    </select>
</mapper>