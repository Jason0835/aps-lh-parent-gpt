        WHERE ID = #{id}
    </select>

    <select id="selectMpSkuProductionTypeByIds" parameterType="list"
            resultMap="MpSkuProductionTypeResult">

        <include refid="selectMpSkuProductionTypeVo"/>
           WHERE  NVL(IS_DELETE,0) = 0  AND ID IN
        <foreach collection="list" item="item" open="(" separator="," close=")">
