    <delete id="deleteMpSkuProductionTypeById" parameterType="Long">
        UPDATE T_MP_SKU_PRODUCTION_TYPE SET IS_DELETE = 1 WHERE ID = #{id}
    </delete>

    <delete id="deleteMpSkuProductionTypeByIds" parameterType="String">
        UPDATE T_MP_SKU_PRODUCTION_TYPE SET IS_DELETE = 1 WHERE ID IN
