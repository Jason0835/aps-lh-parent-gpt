    <sql id="selectMpSkuProductionTypeVo">
        SELECT ID, MES_MATERIAL_CODE, MATERIAL_CODE, MATERIAL_DESC, GENERATE_DATE, PRODUCTION_TYPE, REMARK, IS_DELETE, CREATE_TIME, UPDATE_TIME, CREATE_BY, UPDATE_BY, FROM T_MP_SKU_PRODUCTION_TYPE
