    <select id="selectMpSkuProductionTypeList" parameterType="com.zlt.aps.monthplan.api.domain.entity.MpSkuProductionType" resultMap="MpSkuProductionTypeResult">
        <include refid="selectMpSkuProductionTypeVo"/>
        WHERE NVL(IS_DELETE,0) = 0
