<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.tc.mapper.TcParamsMapper">

    <resultMap type="com.zlt.aps.tc.entity.TcParams" id="ParamsResult">
        <result property="id" column="id"/>
        <result property="paramCode" column="param_code"/>
        <result property="paramName" column="param_name"/>
        <result property="paramValue" column="param_value"/>
        <result property="regularExpression" column="regular_expression"/>
        <result property="errorTips" column="error_tips"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectParamsVo">
        select id, param_code, param_name, param_value, regular_expression, error_tips, remark, del_flag, create_by, create_time, update_by, update_time
        from t_tc_params
    </sql>

    <select id="checkParamsCodeUnique" resultMap="ParamsResult">
        <include refid="selectParamsVo"/>
        where del_flag = '0' and param_code = #{paramCode} and id = #{id} limit 1
    </select>

    <select id="listParams" parameterType="com.zlt.aps.tc.entity.TcParams"
            resultType="com.zlt.aps.tc.api.domain.dto.TcParamsDto">
        <include refid="selectParamsVo"/>
        where del_flag = 0
        <if test="paramCode != null  and paramCode != ''">and INSTR(param_code, #{paramCode}) > 0</if>
        <if test="paramName != null  and paramName != ''">and param_name like concat(concat('%', #{paramName}), '%')
        </if>
        <if test="orderStr == null">
            order by CREATE_TIME desc
        </if>
        <if test="orderStr != null">
            order by ${orderStr}
        </if>
    </select>
</mapper>