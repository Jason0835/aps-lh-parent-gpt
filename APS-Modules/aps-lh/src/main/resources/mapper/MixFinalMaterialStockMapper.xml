<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.lh.mapper.MixFinalMaterialStockMapper">

    <resultMap type="com.zlt.aps.lh.api.domain.entity.MixFinalMaterialStock" id="MixFinalMaterialStockResult">
        <result property="id" column="id"/>
        <result property="factoryCode" column="factory_code"/>
        <result property="materialCode" column="material_code"/>
        <result property="stockNum" column="stock_num"/>
        <result property="stockDate" column="stock_date"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectMixFinalMaterialStockVo">
        select id, factory_code, material_code, stock_num, stock_date, create_by, create_time, update_by, update_time, del_flag, remark from t_mix_final_material_stock
    </sql>

    <select id="selectMixFinalMaterialStockList" parameterType="com.zlt.aps.lh.api.domain.entity.MixFinalMaterialStock"
            resultMap="MixFinalMaterialStockResult">
        <include refid="selectMixFinalMaterialStockVo"/>
        where del_flag = '0'
        <if test="factoryCode != null  and factoryCode != ''">and factory_code = #{factoryCode}</if>
        <if test="materialCode != null  and materialCode != ''">and material_code = #{materialCode}</if>
        <if test="stockDate != null  and stockDate != ''">and stock_date = #{stockDate}</if>
        <if test="orderStr == null">
            order by create_time desc
        </if>
        <if test="orderStr != null">
            order by ${orderStr}
        </if>
    </select>

    <select id="selectMixFinalMaterialStockById" parameterType="Long" resultMap="MixFinalMaterialStockResult">
        <include refid="selectMixFinalMaterialStockVo"/>
        where id = #{id}
    </select>

    <insert id="insertMixFinalMaterialStock" parameterType="com.zlt.aps.lh.api.domain.entity.MixFinalMaterialStock">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT MIX_STOCK_SEQ.NEXTVAL as id FROM DUAL
        </selectKey>
        insert into t_mix_final_material_stock
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="factoryCode != null">factory_code,</if>
            <if test="materialCode != null">material_code,</if>
            <if test="stockNum != null">stock_num,</if>
            <if test="stockDate != null">stock_date,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="factoryCode != null">#{factoryCode},</if>
            <if test="materialCode != null">#{materialCode},</if>
            <if test="stockNum != null">#{stockNum},</if>
            <if test="stockDate != null">#{stockDate},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateMixFinalMaterialStock" parameterType="com.zlt.aps.lh.api.domain.entity.MixFinalMaterialStock">
        update t_mix_final_material_stock
        <trim prefix="SET" suffixOverrides=",">
            <if test="factoryCode != null">factory_code = #{factoryCode},</if>
            <if test="materialCode != null">material_code = #{materialCode},</if>
            <if test="stockNum != null">stock_num = #{stockNum},</if>
            <if test="stockDate != null">stock_date = #{stockDate},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMixFinalMaterialStockById" parameterType="Long">
        update t_mix_final_material_stock set del_flag='1' where id = #{id}
    </delete>

    <delete id="deleteMixFinalMaterialStockByIds" parameterType="String">
        update t_mix_final_material_stock set del_flag='1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>