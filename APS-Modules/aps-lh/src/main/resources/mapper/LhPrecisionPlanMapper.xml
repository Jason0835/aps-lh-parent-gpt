<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.lh.mapper.LhPrecisionPlanMapper">

    <resultMap type="com.zlt.aps.lh.api.domain.entity.LhPrecisionPlan" id="LhPrecisionPlanResult">
        <id property="id" column="ID"/>
        <result property="machineCode" column="MACHINE_CODE"/>
        <result property="precisionType" column="PRECISION_TYPE"/>
        <result property="planDate" column="PLAN_DATE"/>
        <result property="actualDate" column="ACTUAL_DATE"/>
        <result property="scheduleDate" column="SCHEDULE_DATE"/>
        <result property="dueDate" column="DUE_DATE"/>
        <result property="daysToDue" column="DAYS_TO_DUE"/>
        <result property="lastMaintenanceDate" column="LAST_MAINTENANCE_DATE"/>
        <result property="completionStatus" column="COMPLETION_STATUS"/>
        <result property="year" column="YEAR"/>
        <result property="warningStatus" column="WARNING_STATUS"/>
        <result property="warningDate" column="WARNING_DATE"/>
        <result property="isWarningSent" column="IS_WARNING_SENT"/>
        <result property="dataSource" column="DATA_SOURCE"/>
        <result property="mesSourceId" column="MES_SOURCE_ID"/>
        <result property="companyCode" column="COMPANY_CODE"/>
        <result property="factoryCode" column="FACTORY_CODE"/>
        <result property="createBy" column="CREATE_BY"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="updateBy" column="UPDATE_BY"/>
        <result property="updateTime" column="UPDATE_TIME"/>
        <result property="isDelete" column="IS_DELETE"/>
        <result property="remark" column="REMARK"/>
    </resultMap>

    <sql id="selectLhPrecisionPlanVo">
        select ID,
               MACHINE_CODE,
               PRECISION_TYPE,
               PLAN_DATE,
               ACTUAL_DATE,
               SCHEDULE_DATE,
               DUE_DATE,
               DAYS_TO_DUE,
               LAST_MAINTENANCE_DATE,
               COMPLETION_STATUS, YEAR, WARNING_STATUS, WARNING_DATE, IS_WARNING_SENT, DATA_SOURCE, MES_SOURCE_ID, COMPANY_CODE, FACTORY_CODE, CREATE_BY, CREATE_TIME, UPDATE_BY, UPDATE_TIME, IS_DELETE, REMARK
        from T_LH_PRECISION_PLAN
    </sql>

    <select id="selectLhPrecisionPlanList" parameterType="com.zlt.aps.lh.api.domain.vo.LhPrecisionPlanVo"
            resultMap="LhPrecisionPlanResult">
        <include refid="selectLhPrecisionPlanVo"/>
        <where>
            IS_DELETE = 0
            <if test="machineCode != null and machineCode != ''">
                AND MACHINE_CODE like concat('%', #{machineCode}, '%')
            </if>
            <if test="precisionType != null and precisionType != ''">
                AND PRECISION_TYPE = #{precisionType}
            </if>
            <if test="planDateStart != null">
                AND PLAN_DATE &gt;= #{planDateStart}
            </if>
            <if test="planDateEnd != null">
                AND PLAN_DATE &lt;= #{planDateEnd}
            </if>
            <if test="actualDateStart != null">
                AND ACTUAL_DATE &gt;= #{actualDateStart}
            </if>
            <if test="actualDateEnd != null">
                AND ACTUAL_DATE &lt;= #{actualDateEnd}
            </if>
            <if test="completionStatus != null and completionStatus != ''">
                AND COMPLETION_STATUS = #{completionStatus}
            </if>
            <if test="year != null">
                AND YEAR = #{year}
            </if>
            <if test="warningStatus != null and warningStatus != ''">
                AND WARNING_STATUS = #{warningStatus}
            </if>
            <if test="dataSource != null and dataSource != ''">
                AND DATA_SOURCE = #{dataSource}
            </if>
            <if test="companyCode != null and companyCode != ''">
                AND COMPANY_CODE = #{companyCode}
            </if>
            <if test="factoryCode != null and factoryCode != ''">
                AND FACTORY_CODE = #{factoryCode}
            </if>
            <if test="createTimeStart != null">
                AND CREATE_TIME &gt;= #{createTimeStart}
            </if>
            <if test="createTimeEnd != null">
                AND CREATE_TIME &lt;= #{createTimeEnd}
            </if>
        </where>
        order by UPDATE_TIME desc, MACHINE_CODE asc
    </select>

    <select id="selectByMachineCodeAndYear" resultMap="LhPrecisionPlanResult">
        <include refid="selectLhPrecisionPlanVo"/>
        where MACHINE_CODE = #{machineCode}
        and YEAR = #{year}
        and IS_DELETE = 0
        limit 1
    </select>

    <select id="selectLastCompletedPlan" resultMap="LhPrecisionPlanResult">
        <include refid="selectLhPrecisionPlanVo"/>
        where MACHINE_CODE = #{machineCode}
        and YEAR = #{year}
        and COMPLETION_STATUS = '1'
        and ACTUAL_DATE is not null
        and IS_DELETE = 0
        order by ACTUAL_DATE desc
        limit 1
    </select>

    <select id="selectPendingWarningPlans" resultMap="LhPrecisionPlanResult">
        <include refid="selectLhPrecisionPlanVo"/>
        where COMPLETION_STATUS = '0'
        and DAYS_TO_DUE &lt;= #{daysToDue}
        and DAYS_TO_DUE &gt; 0
        and WARNING_STATUS = '0'
        and IS_DELETE = 0
        order by DAYS_TO_DUE asc
    </select>

    <update id="batchUpdateDaysToDue">
        update T_LH_PRECISION_PLAN
        set DAYS_TO_DUE = DATEDIFF(PLAN_DATE, CURDATE())
        where IS_DELETE = 0
          and COMPLETION_STATUS = '0'
    </update>

    <select id="selectNearestScheduleDatePlan" resultMap="LhPrecisionPlanResult">
        <include refid="selectLhPrecisionPlanVo"/>
        where MACHINE_CODE = #{machineCode}
        and FACTORY_CODE = #{factoryCode}
        and ACTUAL_DATE is null
        and SCHEDULE_DATE is not null
        and IS_DELETE = 0
        order by ABS(DATEDIFF(SCHEDULE_DATE, #{actualDate})) asc
        limit 1
    </select>

    <select id="selectByMesSourceId" resultMap="LhPrecisionPlanResult">
        <include refid="selectLhPrecisionPlanVo"/>
        where MES_SOURCE_ID = #{mesSourceId}
        and IS_DELETE = 0
        limit 1
    </select>

    <select id="selectByMesSourceIdBatch" resultMap="LhPrecisionPlanResult">
        <include refid="selectLhPrecisionPlanVo"/>
        where IS_DELETE = 0
        and MES_SOURCE_ID in
        <foreach collection="mesSourceIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <select id="selectByMachineCodesAndYear" resultMap="LhPrecisionPlanResult">
        <include refid="selectLhPrecisionPlanVo"/>
        where IS_DELETE = 0
        and YEAR = #{year}
        and MACHINE_CODE in
        <foreach collection="machineCodes" item="code" open="(" separator="," close=")">
            #{code}
        </foreach>
    </select>

    <select id="selectPendingActualDatePlans" resultMap="LhPrecisionPlanResult">
        <include refid="selectLhPrecisionPlanVo"/>
        where IS_DELETE = 0
        and ACTUAL_DATE is null
        and SCHEDULE_DATE is not null
        <if test="machineCodes != null and machineCodes.size() > 0">
            and MACHINE_CODE in
            <foreach collection="machineCodes" item="code" open="(" separator="," close=")">
                #{code}
            </foreach>
        </if>
        <if test="factoryCodes != null and factoryCodes.size() > 0">
            and FACTORY_CODE in
            <foreach collection="factoryCodes" item="code" open="(" separator="," close=")">
                #{code}
            </foreach>
        </if>
        order by MACHINE_CODE, FACTORY_CODE, SCHEDULE_DATE
    </select>

    <select id="selectPendingScheduleDatePlans" resultMap="LhPrecisionPlanResult">
        <include refid="selectLhPrecisionPlanVo"/>
        where IS_DELETE = 0
        and ACTUAL_DATE is null
        <if test="machineCodes != null and machineCodes.size() > 0">
            and MACHINE_CODE in
            <foreach collection="machineCodes" item="code" open="(" separator="," close=")">
                #{code}
            </foreach>
        </if>
        <if test="factoryCodes != null and factoryCodes.size() > 0">
            and FACTORY_CODE in
            <foreach collection="factoryCodes" item="code" open="(" separator="," close=")">
                #{code}
            </foreach>
        </if>
        order by MACHINE_CODE, FACTORY_CODE
    </select>

    <select id="selectByFactoryMachinePlanBatch" resultMap="LhPrecisionPlanResult">
        <include refid="selectLhPrecisionPlanVo"/>
        where IS_DELETE = 0
        <if test="factoryCodes != null and factoryCodes.size() > 0">
            and FACTORY_CODE in
            <foreach collection="factoryCodes" item="code" open="(" separator="," close=")">
                #{code}
            </foreach>
        </if>
        <if test="machineCodes != null and machineCodes.size() > 0">
            and MACHINE_CODE in
            <foreach collection="machineCodes" item="code" open="(" separator="," close=")">
                #{code}
            </foreach>
        </if>
        <if test="planDates != null and planDates.size() > 0">
            and PLAN_DATE in
            <foreach collection="planDates" item="date" open="(" separator="," close=")">
                #{date}
            </foreach>
        </if>
    </select>

</mapper>
