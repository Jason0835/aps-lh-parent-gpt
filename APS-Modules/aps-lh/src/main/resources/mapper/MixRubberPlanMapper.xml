<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.lh.mapper.MixRubberPlanMapper">

    <resultMap type="com.zlt.aps.lh.api.domain.entity.MixRubberPlan" id="MixRubberPlanResult">
        <result property="id" column="id"/>
        <result property="factoryCode" column="factory_code"/>
        <result property="materialCode" column="material_code"/>
        <result property="machineCode" column="machine_code"/>
        <result property="macheinName" column="machein_name"/>
        <result property="class1PlanQty" column="class1_plan_qty"/>
        <result property="class2PlanQty" column="class2_plan_qty"/>
        <result property="class3PlanQty" column="class3_plan_qty"/>
        <result property="planDate" column="plan_date"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectMixRubberPlanVo">
        select id, factory_code, material_code, machine_code, machein_name, class1_plan_qty, class2_plan_qty, class3_plan_qty, plan_date, create_by, create_time, update_by, update_time, del_flag, remark from t_mix_rubber_plan
    </sql>

    <select id="selectMixRubberPlanList" parameterType="com.zlt.aps.lh.api.domain.entity.MixRubberPlan"
            resultMap="MixRubberPlanResult">
        <include refid="selectMixRubberPlanVo"/>
        where del_flag = '0'
        <if test="factoryCode != null  and factoryCode != ''">and factory_code = #{factoryCode}</if>
        <if test="materialCode != null  and materialCode != ''">and material_code = #{materialCode}</if>
        <if test="planDate != null  and planDate != ''">and plan_date = #{planDate}</if>
        <if test="orderStr == null">
            order by create_time desc
        </if>
        <if test="orderStr != null">
            order by ${orderStr}
        </if>
    </select>

    <select id="selectMixRubberPlanById" parameterType="Long" resultMap="MixRubberPlanResult">
        <include refid="selectMixRubberPlanVo"/>
        where id = #{id}
    </select>

    <insert id="insertMixRubberPlan" parameterType="com.zlt.aps.lh.api.domain.entity.MixRubberPlan">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT TAKE_PLAN_SEQ.NEXTVAL as id FROM DUAL
        </selectKey>
        insert into t_mix_rubber_plan
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="factoryCode != null">factory_code,</if>
            <if test="materialCode != null">material_code,</if>
            <if test="machineCode != null">machine_code,</if>
            <if test="macheinName != null">machein_name,</if>
            <if test="class1PlanQty != null">class1_plan_qty,</if>
            <if test="class2PlanQty != null">class2_plan_qty,</if>
            <if test="class3PlanQty != null">class3_plan_qty,</if>
            <if test="planDate != null">plan_date,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="factoryCode != null">#{factoryCode},</if>
            <if test="materialCode != null">#{materialCode},</if>
            <if test="machineCode != null">#{machineCode},</if>
            <if test="macheinName != null">#{macheinName},</if>
            <if test="class1PlanQty != null">#{class1PlanQty},</if>
            <if test="class2PlanQty != null">#{class2PlanQty},</if>
            <if test="class3PlanQty != null">#{class3PlanQty},</if>
            <if test="planDate != null">#{planDate},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateMixRubberPlan" parameterType="com.zlt.aps.lh.api.domain.entity.MixRubberPlan">
        update t_mix_rubber_plan
        <trim prefix="SET" suffixOverrides=",">
            <if test="factoryCode != null">factory_code = #{factoryCode},</if>
            <if test="materialCode != null">material_code = #{materialCode},</if>
            <if test="machineCode != null">machine_code = #{machineCode},</if>
            <if test="macheinName != null">machein_name = #{macheinName},</if>
            <if test="class1PlanQty != null">class1_plan_qty = #{class1PlanQty},</if>
            <if test="class2PlanQty != null">class2_plan_qty = #{class2PlanQty},</if>
            <if test="class3PlanQty != null">class3_plan_qty = #{class3PlanQty},</if>
            <if test="planDate != null">plan_date = #{planDate},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMixRubberPlanById" parameterType="Long">
        update t_mix_rubber_plan set del_flag='1' where id = #{id}
    </delete>

    <delete id="deleteMixRubberPlanByIds" parameterType="String">
        update t_mix_rubber_plan set del_flag='1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>