<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.lh.mapper.LhDispatcherLogMapper">

    <resultMap type="com.zlt.aps.lh.api.domain.entity.LhDispatcherLog" id="LhDispatcherLogResult">
        <result property="id" column="id"/>
        <result property="operType" column="oper_type"/>
        <result property="scheduleDate" column="schedule_date"/>
        <result property="sapCode" column="sap_code"/>
        <result property="beforeMachineCode" column="before_machine_code"/>
        <result property="beforeClass1Plan" column="before_class1_plan"/>
        <result property="beforeClass2Plan" column="before_class2_plan"/>
        <result property="beforeClass3Plan" column="before_class3_plan"/>
        <result property="afterMachineCode" column="after_machine_code"/>
        <result property="afterClass1Plan" column="after_class1_plan"/>
        <result property="afterClass2Plan" column="after_class2_plan"/>
        <result property="afterClass3Plan" column="after_class3_plan"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectLhDispatcherLogVo">
        select id, oper_type, schedule_date, SAP_CODE, before_machine_code, before_class1_plan, before_class2_plan, before_class3_plan, after_machine_code,
               after_class1_plan, after_class2_plan, after_class3_plan, remark, del_flag, create_by, create_time, update_by, update_time from t_lh_dispatcher_log
    </sql>

    <select id="selectLhDispatcherLogList" parameterType="com.zlt.aps.lh.api.domain.entity.LhDispatcherLog"
            resultMap="LhDispatcherLogResult">
        <include refid="selectLhDispatcherLogVo"/>
        where del_flag = '0'
        <if test="operType != null  and operType != ''">and oper_type = #{operType}</if>
        <if test="scheduleDate != null ">and schedule_date = #{scheduleDate,jdbcType=DATE}</if>
        <if test="createBy != null and createBy != ''">
            and INSTR(create_by, #{createBy}) > 0
        </if>
        <if test="startTime != null and startTime !='' ">
            and create_time  <![CDATA[  >=  ]]> to_date(#{startTime},'yyyy-MM-dd')
        </if>
        <if test="endTime != null and endTime !='' ">
            and create_time  <![CDATA[   <=  ]]> to_date(#{endTime},'yyyy-mm-dd hh24:mi:ss')
        </if>
        <if test="orderStr == null">
            order by create_time desc
        </if>
        <if test="orderStr != null">
            order by ${orderStr}
        </if>

    </select>

    <select id="selectLhDispatcherLogById" parameterType="Long" resultMap="LhDispatcherLogResult">
        <include refid="selectLhDispatcherLogVo"/>
        where id = #{id}
    </select>

    <insert id="insertLhDispatcherLog" parameterType="com.zlt.aps.lh.api.domain.entity.LhDispatcherLog">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT seq_t_lh_dispatcher_log.NEXTVAL as id FROM DUAL
        </selectKey>
        insert into t_lh_dispatcher_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="scheduleId != null">schedule_id,</if>
            <if test="operType != null">oper_type,</if>
            <if test="scheduleDate != null">schedule_date,</if>
            <if test="sapCode != null">sap_code,</if>
            <if test="beforeMachineCode != null">before_machine_code,</if>
            <if test="beforeClass1Plan != null">before_class1_plan,</if>
            <if test="beforeClass2Plan != null">before_class2_plan,</if>
            <if test="beforeClass3Plan != null">before_class3_plan,</if>
            <if test="afterMachineCode != null">after_machine_code,</if>
            <if test="afterClass1Plan != null">after_class1_plan,</if>
            <if test="afterClass2Plan != null">after_class2_plan,</if>
            <if test="afterClass3Plan != null">after_class3_plan,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="scheduleId != null">#{scheduleId},</if>
            <if test="operType != null">#{operType},</if>
            <if test="scheduleDate != null">#{scheduleDate},</if>
            <if test="sapCode != null">#{sapCode},</if>
            <if test="beforeMachineCode != null">#{beforeMachineCode},</if>
            <if test="beforeClass1Plan != null">#{beforeClass1Plan},</if>
            <if test="beforeClass2Plan != null">#{beforeClass2Plan},</if>
            <if test="beforeClass3Plan != null">#{beforeClass3Plan},</if>
            <if test="afterMachineCode != null">#{afterMachineCode},</if>
            <if test="afterClass1Plan != null">#{afterClass1Plan},</if>
            <if test="afterClass2Plan != null">#{afterClass2Plan},</if>
            <if test="afterClass3Plan != null">#{afterClass3Plan},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <delete id="deleteLhDispatcherLogById" parameterType="Long">
        update t_lh_dispatcher_log set del_flag='1' where id = #{id}
    </delete>

    <delete id="deleteLhDispatcherLogByIds" parameterType="String">
        update t_lh_dispatcher_log set del_flag='1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>