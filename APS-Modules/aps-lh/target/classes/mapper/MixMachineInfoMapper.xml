<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.lh.mapper.MixMachineInfoMapper">

    <resultMap type="com.zlt.aps.lh.api.domain.entity.MixMachineInfo" id="MixMachineInfoResult">
        <result property="id" column="id"/>
        <result property="factoryCode" column="factory_code"/>
        <result property="machineCode" column="machine_code"/>
        <result property="machineName" column="machine_name"/>
        <result property="machineType" column="machine_type"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectMixMachineInfoVo">
        select id, factory_code, machine_code, machine_name, machine_type, status, create_by, create_time, update_by, update_time, del_flag, remark from t_mix_machine_info
    </sql>

    <select id="selectMixMachineInfoList" parameterType="com.zlt.aps.lh.api.domain.entity.MixMachineInfo"
            resultMap="MixMachineInfoResult">
        <include refid="selectMixMachineInfoVo"/>
        where del_flag = '0'
        <if test="factoryCode != null  and factoryCode != ''">and factory_code = #{factoryCode}</if>
        <if test="machineName != null  and machineName != ''">and machine_name like concat(concat('%', #{machineName}),
            '%')
        </if>
        <if test="machineType != null  and machineType != ''">and machine_type = #{machineType}</if>
        <if test="orderStr == null">
            order by create_time desc
        </if>
        <if test="orderStr != null">
            order by ${orderStr}
        </if>
    </select>

    <select id="selectMixMachineInfoById" parameterType="Long" resultMap="MixMachineInfoResult">
        <include refid="selectMixMachineInfoVo"/>
        where id = #{id}
    </select>

    <insert id="insertMixMachineInfo" parameterType="com.zlt.aps.lh.api.domain.entity.MixMachineInfo">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT MIX_MACHINE_SEQ.NEXTVAL as id FROM DUAL
        </selectKey>
        insert into t_mix_machine_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="factoryCode != null">factory_code,</if>
            <if test="machineCode != null">machine_code,</if>
            <if test="machineName != null">machine_name,</if>
            <if test="machineType != null">machine_type,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="factoryCode != null">#{factoryCode},</if>
            <if test="machineCode != null">#{machineCode},</if>
            <if test="machineName != null">#{machineName},</if>
            <if test="machineType != null">#{machineType},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateMixMachineInfo" parameterType="com.zlt.aps.lh.api.domain.entity.MixMachineInfo">
        update t_mix_machine_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="factoryCode != null">factory_code = #{factoryCode},</if>
            <if test="machineCode != null">machine_code = #{machineCode},</if>
            <if test="machineName != null">machine_name = #{machineName},</if>
            <if test="machineType != null">machine_type = #{machineType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMixMachineInfoById" parameterType="Long">
        update t_mix_machine_info set del_flag='1' where id = #{id}
    </delete>

    <delete id="deleteMixMachineInfoByIds" parameterType="String">
        update t_mix_machine_info set del_flag='1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>