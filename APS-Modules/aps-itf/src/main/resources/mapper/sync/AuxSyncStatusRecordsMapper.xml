        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.sync.mapper.AuxSyncStatusRecordsMapper">

    <select id="selectList" parameterType="Map" resultType="com.zlt.sync.domain.AuxSyncStatusRecords">
        SELECT  ST_ID AS stId <!-- 主键id --> ,
                ST_TYPE AS stType <!-- 状态类型 --> ,
                ST_NAME AS stName <!-- 状态名称 --> ,
                ST_VALUE AS stValue <!-- 状态值 --> ,
                DATA_VERSION AS dataVersion <!-- 数据版本号 --> ,
                CREATE_DATE AS createDate <!-- 创建日期 --> ,
                UPDATE_DATE AS updateDate <!-- 更新日期 --> ,
                IS_DELETE AS isDelete <!-- 删除标志 -->
        FROM AUX_SYNC_STATUS_RECORDS
        WHERE 1=1
        <if test="stType!=null and stType != ''">
            AND ST_TYPE = #{stType}
        </if>

        <if test="stName!=null and stName != ''">
            AND ST_NAME = #{stName}
        </if>

        <if test="stValue!=null and stValue != ''">
