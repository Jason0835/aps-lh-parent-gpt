            <if test="auxSyncStatusRecords.dataVersion != null and auxSyncStatusRecords.dataVersion != '' ">
                DATA_VERSION,
            </if>
            <if test="auxSyncStatusRecords.createDate != null">
                CREATE_DATE,
            </if>
            <if test="auxSyncStatusRecords.updateDate != null">
                UPDATE_DATE,
            </if>
            <if test="auxSyncStatusRecords.isDelete != null">
                IS_DELETE,
            </if>
        </trim>
    </sql>

    <sql id="values">
