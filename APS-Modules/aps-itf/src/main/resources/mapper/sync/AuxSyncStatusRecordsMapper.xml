            </if>
            <if test="auxSyncStatusRecords.dataVersion != null and auxSyncStatusRecords.dataVersion != '' ">
                #{auxSyncStatusRecords.dataVersion},
            </if>
            <if test="auxSyncStatusRecords.createDate != null">
                #{auxSyncStatusRecords.createDate},
            </if>
            <if test="auxSyncStatusRecords.updateDate != null">
                #{auxSyncStatusRecords.updateDate},
            </if>
            <if test="auxSyncStatusRecords.isDelete != null">
                #{auxSyncStatusRecords.isDelete},
            </if>
        </trim>
    </sql>

    <update id="update" parameterType="com.zlt.sync.domain.AuxSyncStatusRecords">
        UPDATE AUX_SYNC_STATUS_RECORDS
        <set>
            <if test="auxSyncStatusRecords.stId != null and auxSyncStatusRecords.stId != '' ">
                ST_ID=#{auxSyncStatusRecords.stId},
            </if>
            <if test="auxSyncStatusRecords.stType != null and auxSyncStatusRecords.stType != '' ">
