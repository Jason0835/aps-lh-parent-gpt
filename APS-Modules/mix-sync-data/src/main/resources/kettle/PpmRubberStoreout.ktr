    </partitioning>
    <connection>MES_DATA</connection>
    <sql>select cast(convert(varchar(10),getdate(),120) as datetime) as scheduleDate,
       substring(ss.StorageName, 1, 2) mixArea, 
	   rtrim(s.MaterCode) MaterialCode,
	   rtrim(m.MaterialName) MaterialName, 
	   s.ShelfNum ,
	   s.Barcode,
	   s.recorddate
  from PpmRubberStoreout s with(nolock)
 inner join BasStorage ss with(nolock) on ss.StorageID = s.StorageID and ss.DeleteFlag = 0 
 inner join BasMaterial m with(nolock) on m.MaterialCode = s.MaterCode
 where recorddate between cast(convert(varchar(10),dateadd(dd, -1, getdate()),120)+' 16:00:00' as datetime) 
   and cast(convert(varchar(10),getdate(),120)+' 08:00:00' as datetime)
   and ss.StorageName like 'M%'
   and s.ShelfNum > 0</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
