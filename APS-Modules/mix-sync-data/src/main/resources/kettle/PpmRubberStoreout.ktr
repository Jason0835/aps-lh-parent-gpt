  <step>
    <name>更新待支领量</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>LL_MIX</connection>
    <execute_each_row>Y</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <sql>MERGE INTO T_GLUE_UNCLAIMED A
USING (SELECT P.MIX_AREA,
              P.PLAN_DATE,
              P.GLUE,
              CASE
                WHEN NVL(P.TOTAL_PLAN_QTY, 0) > NVL(S.SHELF_NUM, 0) THEN
                 NVL(P.TOTAL_PLAN_QTY, 0) - NVL(S.SHELF_NUM, 0)
                ELSE
                 0
              END SHELF_NUM
         FROM T_GLUE_COLLECT_PLAN P
         LEFT JOIN (SELECT S.SCHEDULE_DATE,
                          S.MIX_AREA,
                          S.MATERIAL_NAME,
                          SUM(S.SHELF_NUM) SHELF_NUM
                     FROM T_MES_PPM_RUBBER_STORE_OUT S
                    WHERE S.SCHEDULE_DATE = trunc(sysdate)
                      AND S.DEL_FLAG = '0'
                    GROUP BY S.SCHEDULE_DATE, S.MIX_AREA, S.MATERIAL_NAME) S
           ON P.PLAN_DATE = S.SCHEDULE_DATE
          AND P.GLUE = S.MATERIAL_NAME
          AND P.MIX_AREA = S.MIX_AREA
        WHERE P.PLAN_DATE = trunc(sysdate)
          AND P.DEL_FLAG = '0'
       UNION
       SELECT U.MIX_AREA, U.SCHEDULE_DATE, U.GLUE, 0
         FROM T_GLUE_UNCLAIMED U
        WHERE NOT EXISTS (SELECT 0
                 FROM T_GLUE_COLLECT_PLAN P
                WHERE P.PLAN_DATE = U.SCHEDULE_DATE
                  AND P.GLUE = U.GLUE
                  AND P.MIX_AREA = U.MIX_AREA
                  AND P.DEL_FLAG = '0')
          AND U.SCHEDULE_DATE = trunc(sysdate)
          AND U.DEL_FLAG = '0') B
ON (A.MIX_AREA = B.MIX_AREA AND A.SCHEDULE_DATE = B.PLAN_DATE AND A.GLUE = B.GLUE AND A.DEL_FLAG = '0')
WHEN MATCHED THEN
  UPDATE SET A.SHELF_NUM1 = B.SHELF_NUM, A.UPDATE_TIME = SYSDATE
WHEN NOT MATCHED THEN
  INSERT
    (A.ID,
     A.SCHEDULE_DATE,
     A.GLUE,
     A.SHELF_NUM1,
     A.SHELF_NUM2,
     A.MIX_AREA,
     A.CREATE_TIME)
  VALUES
    (GET_SEQUENCE_NEXTVAL('SEQ_GLUE_UNCLAIMED'),
     B.PLAN_DATE,
     B.GLUE,
     B.SHELF_NUM,
     0,
     B.MIX_AREA,
     SYSDATE)
</sql>
