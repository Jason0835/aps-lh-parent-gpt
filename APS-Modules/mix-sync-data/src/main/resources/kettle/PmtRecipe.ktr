  <step>
    <name>需要同步的数据_称重表</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MES_DATA</connection>
    <sql>SELECT 
convert(varchar(40), w.ObjID) ObjID,
w.recipeobjid,
w.weightid,
rtrim(w.materialcode) materialcode,
rtrim(w.MaterialName) recpieMaterialName,
rtrim(isNull(m.MaterialName, w.MaterialName)) MaterialName,
isNull(w.setweight, 0) setweight,
w.errorallow
FROM PmtRecipeWeight w with(nolock)
 left join BasMaterial m with(nolock) on m.MaterialCode = w.materialcode AND m.DeleteFlag = 0
WHERE exists (
  select 1
    from PmtRecipe r with(nolock)
   where r.objid = w.recipeobjid
     and (r.AuditDateTime > ? OR RecipeModifyTime > ?)
)
union

SELECT 
convert(varchar(30), w.RecipeObjID) + '_' +  convert(varchar(10), w.WeightID) ObjID,
w.recipeobjid,
w.weightid,
rtrim(w.materialcode) materialcode,
rtrim(w.MaterialName) recpieMaterialName,
rtrim(isNull(m.MaterialName, w.MaterialName)) MaterialName,
isNull(w.setweight, 0) setweight,
w.errorallow
FROM PmtRecipeWeightMid w with(nolock)
 left join BasMaterial m with(nolock) on m.MaterialCode = w.materialcode AND m.DeleteFlag = 0
WHERE exists (
  select 1
    from PmtRecipe r with(nolock)
   where r.objid = w.recipeobjid
     and (r.AuditDateTime > ? OR RecipeModifyTime > ?)
)
</sql>
