      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>删除配方</from>
      <to>备份称重配方</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>查询时间戳</from>
      <to>需要处理的配方ID</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>到MES取配方重量</from>
      <to>判断MES是否存在称重</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>判断MES是否存在称重</from>
      <to>存在则什么也不做</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>判断MES是否存在称重</from>
      <to>备份单个称重配方</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>备份单个称重配方</from>
      <to>删除单个称重配方</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>需要处理的配方ID</from>
      <to>到APS取配方重量</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>判断MES是否存在Q药</from>
      <to>存在则什么也不做 2</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>到MES取Q药</from>
