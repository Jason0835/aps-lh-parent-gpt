    <connection>LL_MIX</connection>
    <rowlimit>0</rowlimit>
    <sql>select r.recipe_id, 
case when instr(r.recipe_id, '_') > 0 then 1 else 0 end isMid,
substr(r.recipe_id, 0, instr(r.recipe_id, '_') - 1) mid_recipeObjid,
substr(r.recipe_id, instr(r.recipe_id, '_') + 1, length(r.recipe_id)) mid_weightid
from T_MES_PMT_RECIPE_WEIGHT r where r.father_recipe_id = ?</sql>
