      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>判断MES是否存在Q药</from>
      <to>备份单个称重配方</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>查询时间戳 2</from>
      <to>需要同步的数据_称重表</to>
      <enabled>Y</enabled>
    </hop>
