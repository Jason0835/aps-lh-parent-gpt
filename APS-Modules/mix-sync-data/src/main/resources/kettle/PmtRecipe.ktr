  <step>
    <name>需要同步的数据_配方表</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MES_DATA</connection>
    <sql>SELECT t.objid,
t.recipeversionid,
t.recipetype,
rtrim(isNull(m.MaterialName, t.recipematerialname)) recipematerialname,
rtrim(t.recipematerialname) materName,
t.recipestate,
t.lottotalweight,
t.auditflag,
rtrim(t.recipeequipcode) recipeequipcode,
t.jieduan,
t.LotDoneTime,
rtrim(t.RecipeMaterialCode) RecipeMaterialCode,
case when t.AuditDateTime is null and t.RecipeModifyTime is not null then RecipeModifyTime
     when t.AuditDateTime is not null and t.RecipeModifyTime is null then AuditDateTime
     when t.AuditDateTime >= t.RecipeModifyTime then AuditDateTime
     when t.RecipeModifyTime >= t.AuditDateTime then RecipeModifyTime
else null end AuditDateTime,
e.equipName
 FROM PmtRecipe t with(nolock) 
 left join BasEquip e with(nolock) on t.RecipeEquipCode = e.EquipCode
 left join BasMaterial m with(nolock) on m.MaterialCode = t.RecipeMaterialCode AND m.DeleteFlag = 0
WHERE T.AuditDateTime > ? OR RecipeModifyTime > ?</sql>
    <limit>0</limit>
    <lookup>查询时间戳</lookup>
