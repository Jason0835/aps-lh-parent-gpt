  <step>
    <name>备份单个称重配方</name>
    <type>ExecSQL</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>LL_MIX</connection>
    <execute_each_row>Y</execute_each_row>
    <single_statement>N</single_statement>
    <replace_variables>N</replace_variables>
    <quoteString>N</quoteString>
    <sql>MERGE INTO T_MES_PMT_RECIPE_WEIGHT_LOG A USING(
SELECT   ID,
   FATHER_RECIPE_ID,
   RECIPE_ID,
   WEIGHT_ORDER,
   RECIPE_MATERIAL_CODE,
   RECIPE_MATERIAL_NAME,
   SET_WEIGHT,
   ALLOW_ERROR,
   REMARK,
   DEL_FLAG,
   CREATE_BY,
   CREATE_TIME,
   UPDATE_BY,
   UPDATE_TIME,
   MATERIAL_NAME
FROM T_MES_PMT_RECIPE_WEIGHT
WHERE RECIPE_ID = '?'
   ) b
ON (a.id = b.id)
WHEN NOT MATCHED THEN
INSERT (
   a.ID,
   a.FATHER_RECIPE_ID,
   a.RECIPE_ID,
   a.WEIGHT_ORDER,
   a.RECIPE_MATERIAL_CODE,
   a.RECIPE_MATERIAL_NAME,
   a.SET_WEIGHT,
   a.ALLOW_ERROR,
   a.REMARK,
   a.DEL_FLAG,
   a.CREATE_BY,
   a.CREATE_TIME,
   a.UPDATE_BY,
   a.UPDATE_TIME,
   a.MATERIAL_NAME
) VALUES (
   b.ID,
   b.FATHER_RECIPE_ID,
   b.RECIPE_ID,
   b.WEIGHT_ORDER,
   b.RECIPE_MATERIAL_CODE,
   b.RECIPE_MATERIAL_NAME,
   b.SET_WEIGHT,
   b.ALLOW_ERROR,
   b.REMARK,
   b.DEL_FLAG,
   b.CREATE_BY,
   b.CREATE_TIME,
   b.UPDATE_BY,
   b.UPDATE_TIME,
   b.MATERIAL_NAME
)</sql>
