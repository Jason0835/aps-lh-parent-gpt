    <sql>MERGE INTO T_MES_PMT_RECIPE_LOG A USING(
SELECT ID,
   RECIPE_ID,
   MIX_AREA,
   RECIPE_EQUIP_CODE,
   RECIPE_MATERIAL_CODE,
   RECIPE_MATERIAL_NAME,
   RECIPE_VERSION_ID,
   RECIPE_TYPE,
   PRODUCT_STAGE,
   SUMMER_MIX_TIME,
   WINTER_MIX_TIME,
   LOT_TOTAL_WEIGHT,
   RECIPE_STATE,
   AUDIT_FLAG,
   REMARK,
   DEL_FLAG,
   CREATE_BY,
   CREATE_TIME,
   UPDATE_BY,
   UPDATE_TIME,
   AUDIT_TIME
FROM T_MES_PMT_RECIPE
WHERE RECIPE_ID = '?'
) b
on (a.id = b.id)
WHEN NOT MATCHED THEN
INSERT (
   a.ID,
   a.RECIPE_ID,
   a.MIX_AREA,
   a.RECIPE_EQUIP_CODE,
   a.RECIPE_MATERIAL_CODE,
   a.RECIPE_MATERIAL_NAME,
   a.RECIPE_VERSION_ID,
   a.RECIPE_TYPE,
   a.PRODUCT_STAGE,
   a.SUMMER_MIX_TIME,
   a.WINTER_MIX_TIME,
   a.LOT_TOTAL_WEIGHT,
   a.RECIPE_STATE,
   a.AUDIT_FLAG,
   a.REMARK,
   a.DEL_FLAG,
   a.CREATE_BY,
   a.CREATE_TIME,
   a.UPDATE_BY,
   a.UPDATE_TIME,
   a.AUDIT_TIME)
VALUES(
   b.ID,
   b.RECIPE_ID,
   b.MIX_AREA,
   b.RECIPE_EQUIP_CODE,
   b.RECIPE_MATERIAL_CODE,
   b.RECIPE_MATERIAL_NAME,
   b.RECIPE_VERSION_ID,
   b.RECIPE_TYPE,
   b.PRODUCT_STAGE,
   b.SUMMER_MIX_TIME,
   b.WINTER_MIX_TIME,
   b.LOT_TOTAL_WEIGHT,
   b.RECIPE_STATE,
   b.AUDIT_FLAG,
   b.REMARK,
   b.DEL_FLAG,
   b.CREATE_BY,
   b.CREATE_TIME,
   b.UPDATE_BY,
   b.UPDATE_TIME,
   b.AUDIT_TIME
)
</sql>
