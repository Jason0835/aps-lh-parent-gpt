      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>到MES取配方</from>
      <to>判断MES是否还存在</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>判断MES是否还存在</from>
      <to>如果存在则什么也不做</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>判断MES是否还存在</from>
      <to>备份配方</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>备份配方</from>
      <to>删除配方</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>备份称重配方</from>
