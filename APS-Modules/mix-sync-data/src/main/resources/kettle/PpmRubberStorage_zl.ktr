  <step>
    <name>查询实时数据</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MES_DATA</connection>
    <sql>SELECT 
Barcode,
ltrim(ss.StorageName) StoragePlaceName,
b.MaterialName,
MaterCode,
realnum,
realweight,
s.ValidDate from PpmRubberStorage s with(nolock)
inner join BasMaterial b with(nolock) on b.MaterialCode = s.MaterCode and b.DeleteFlag = 0
left join BasStorage ss with(nolock) on ss.StorageID = s.StorageID and ss.DeleteFlag = 0 
where realWeight > 0 
  and DATEDIFF(mm, bdsaveTime, GETDATE()) &lt;= 6
  and s.ValidDate >= GETDATE()
  and ltrim(ss.StorageName) like 'M_合格胶库%'</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>624</xloc>
      <yloc>256</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>生成主键</name>
    <type>DBJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>LL_MIX</connection>
    <rowlimit>0</rowlimit>
    <sql>SELECT CASE
         WHEN R.ID IS NULL THEN
          GET_SEQUENCE_NEXTVAL('SEQ_T_GLUE_STOCK')
         ELSE
          0
       END NEWID,
       TRUNC(SYSDATE) STOCKDATE,
       SYSDATE CURRENTTIME,
       '0' DEL_FLAG
  FROM DUAL
  LEFT JOIN T_GLUE_STOCK R
    ON R.Stock_Date = TRUNC(SYSDATE) AND R.bar_code = ?
   AND R.DEL_FLAG = '0'</sql>
    <outer_join>Y</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
