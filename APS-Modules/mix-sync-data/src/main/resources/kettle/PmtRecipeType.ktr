  <step>
    <name>生成主键</name>
    <type>DBJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>LL_MIX</connection>
    <rowlimit>0</rowlimit>
    <sql>SELECT CASE
         WHEN R.ID IS NULL THEN
          GET_SEQUENCE_NEXTVAL('SEQ_T_RECIPE_TYPE')
         ELSE
          0
       END NEWID,
       '0' delflag,
       SYSDATE CURRENTTIME
  FROM DUAL
  LEFT JOIN T_RECIPE_TYPE R
    ON R.Recipe_Type_Code = ?</sql>
    <outer_join>Y</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>ItemCode</name>
        <type>String</type>
      </field>
    </parameter>
