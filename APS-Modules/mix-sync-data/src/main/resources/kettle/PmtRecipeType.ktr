    </partitioning>
    <connection>MES_DATA</connection>
    <sql>select ItemCode,ItemName from SysCode with(nolock) where TypeID ='pmttype'</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
