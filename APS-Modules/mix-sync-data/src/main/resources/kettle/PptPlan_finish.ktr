  <step>
    <name>获取完成量数据</name>
    <type>TableInput</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>MES_DATA</connection>
    <sql>SELECT 
  plandate,
  recipeMaterialName,
  apscode,
  recipeEquipCode,
  SUM(mid_realnum) AS mid_realnum,
  SUM(night_realnum) AS night_realnum,
  SUM(day_realnum) AS day_realnum
FROM (
  SELECT CASE WHEN p.shiftid = 1 THEN p.realnum
         ELSE NULL END AS mid_realnum,
         CASE WHEN p.shiftid = 2 THEN p.realnum
         ELSE NULL END AS night_realnum,
         CASE WHEN p.shiftid = 3 THEN p.realnum
         ELSE NULL END AS day_realnum,
         case when CHARINDEX('_', p.apscode) > 0 then substring(p.apscode, 0, CHARINDEX('_', p.apscode))
              else p.apscode end apscode, 
         p.plandate,
         p.recipeEquipCode,
         p.recipeMaterialName
    FROM PptPlan p with(nolock)
   -- 抓取当天内有完成量的数据
   WHERE PlanDate >= case when CONVERT(varchar(10), GETDATE(), 108) &lt; '16:00:00' then DATEADD(DAY, 0, DATEDIFF(DAY, 0, DATEADD(day, -1, GETDATE())))
					     else DATEADD(DAY, 0, DATEDIFF(DAY, 0, GETDATE())) end
     AND p.realnum > 0
     AND exists (SELECT 0 FROM BasMaterial m
           WHERE m.materialCode = p.recipeMaterialCode and m.DeleteFlag = 0
             AND m.majortypeid IN ('3', '4', '5', '6') --所有胶料的排程完成量都抓取
     )
) t
GROUP BY plandate, recipeMaterialName, apscode, recipeEquipCode
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
