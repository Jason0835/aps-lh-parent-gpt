    <connection>LL_MIX</connection>
    <rowlimit>0</rowlimit>
    <sql>SELECT CASE
         WHEN R.ID IS NULL THEN
          GET_SEQUENCE_NEXTVAL('SEQ_T_GLUE_FINISH')
         ELSE
          0
       END NEWID,
       '0' delflag,
       case when ? is null then r.mid_finish_qty else ? end mid_finish_qty,
       case when ? is null then r.night_finish_qty else ? end night_finish_qty,
       case when ? is null then r.day_finish_qty else ? end day_finish_qty,
       SYSDATE CURRENTTIME
  FROM DUAL
  LEFT JOIN T_GLUE_FINISH R
    ON r.order_no = ?</sql>
