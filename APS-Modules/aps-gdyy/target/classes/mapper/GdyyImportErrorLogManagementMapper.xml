<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.gdyy.mapper.GdyyImportErrorLogManagementMapper">

    <!-- 通用查询映射结果 -->
    <select id="listImportErrorLogManagement" parameterType="com.zlt.aps.gdyy.api.domain.dto.GdyyImportErrorLogManagementDto" resultType="com.zlt.aps.gdyy.api.domain.dto.GdyyImportErrorLogManagementDto">
        select *
        from T_IMPORT_ERROR_LOG
        where DEL_FLAG = 0
        and IMPORT_LOG_ID = #{importLogId}
        <if test="errorRow != null and errorRow != ''">
            and ERROR_ROW = #{errorRow}
        </if>
        <if test="errorDetail != null and errorDetail != ''">
            and error_Detail  like concat(concat('%', #{errorDetail}), '%')
        </if>
        <if test="orderStr == null">
            order by ERROR_ROW
        </if>
        <if test="orderStr != null">
            order by ${orderStr}
        </if>
    </select>

</mapper>
