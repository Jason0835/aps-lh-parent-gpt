<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.cx.mapper.entity.CxParamsMapper">

    <resultMap type="com.zlt.aps.cxlh.cx.api.domain.entity.CxParams" id="paramsResult">
        <result property="id" column="id"/>
        <result property="paramCode" column="param_code"/>
        <result property="paramName" column="param_name"/>
        <result property="paramValue" column="param_value"/>
        <result property="regularExpression" column="regular_expression"/>
        <result property="errorTips" column="error_tips"/>
        <result property="remark" column="remark"/>
        <result property="isDelete" column="is_delete"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectParamsVo">
        select id, param_code, param_name, param_value, regular_expression, error_tips, remark, is_delete, create_by,
        create_time, update_by, update_time
        from t_cx_params
    </sql>

    <select id="checkParamsCodeUnique" resultMap="paramsResult">
        <include refid="selectParamsVo"/>
        where is_delete = '0' and param_code = #{paramCode} and id = #{id}
    </select>

    <select id="listParams" parameterType="com.zlt.aps.cxlh.cx.api.domain.entity.CxParams"
            resultType="com.zlt.aps.cxlh.cx.api.domain.dto.CxParamsDto">
        <include refid="selectParamsVo"/>
        where is_delete = 0
        <if test="paramCode != null  and paramCode != ''">and INSTR(param_code, #{paramCode}) > 0</if>
        <if test="paramName != null  and paramName != ''">and param_name like concat(concat('%', #{paramName}), '%')
        </if>
        <if test="orderStr == null">
            order by create_time desc
        </if>
        <if test="orderStr != null">
            order by ${orderStr}
        </if>
    </select>

    <select id="selectCxShowDeDtoList" resultType="com.zlt.aps.cxlh.cx.api.domain.dto.CxShowDeDto">
        select * from t_cx_show_de
        where is_delete = 0
        <if test="processCode != null  and processCode != ''">and PROCESS_CODE like concat(concat('%', #{processCode}), '%')</if>
        <if test="processDesc != null  and processDesc != ''">and PROCESS_DESC like concat(concat('%', #{processDesc}), '%')</if>
    </select>

    <select id="selecLhShowDeDtoList" resultType="com.zlt.aps.cxlh.cx.api.domain.dto.LhShowDeDto">
        select * from t_lh_show_de
        where is_delete = 0
        <if test="processCode != null  and processCode != ''">and PROCESS_CODE like concat(concat('%', #{processCode}), '%')</if>
        <if test="sapCode != null  and sapCode != ''">and SAP_CODE like concat(concat('%', #{sapCode}), '%')</if>
    </select>
</mapper>