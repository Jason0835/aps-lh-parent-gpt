<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.maindata.mapper.MdmMouldShellInfoEntityMapper">

    <select id="selectByUniqueKeyList" resultType="com.zlt.aps.monthplan.api.domain.entity.MdmMouldShellInfo">
        SELECT * FROM T_MDM_MOULD_SHELL_INFO WHERE IS_DELETE = 0
        <if test="list != null and list.size() > 0">
            AND (FACTORY_CODE, MOLD_MODEL_CODE) IN
            <foreach collection="list" item="item" open="(" separator="," close=")">
                (#{item.factoryCode}, #{item.moldModelCode})
            </foreach>
        </if>
    </select>
</mapper>
