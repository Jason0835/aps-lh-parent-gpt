<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.maindata.mapper.RawMaterialMonthDiffMapper">

    <resultMap id="BaseResultMap" type="com.zlt.aps.monthplan.api.domain.entity.RawMaterialMonthDiff">
        <!-- 这里配置字段映射 -->
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="factory_code" property="factoryCode" jdbcType="VARCHAR"/>
        <result column="year" property="year" jdbcType="INTEGER"/>
        <result column="month" property="month" jdbcType="INTEGER"/>
        <result column="material_code" property="materialCode" jdbcType="VARCHAR"/>
        <result column="material_desc" property="materialDesc" jdbcType="VARCHAR"/>
        <result column="diff_type" property="diffType" jdbcType="VARCHAR"/>
        <result column="prev_month_qty" property="prevMonthQty" jdbcType="DECIMAL"/>
        <result column="cur_month_qty" property="curMonthQty" jdbcType="DECIMAL"/>
        <result column="diff_qty" property="diffQty" jdbcType="DECIMAL"/>
        <result column="create_by" property="createBy" jdbcType="VARCHAR"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 批量插入原材料月差异数据 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO T_RAW_MATERIAL_MONTH_DIFF (
        factory_code,
        year,
        month,
        material_code,
        material_desc,
        diff_type,
        prev_month_qty,
        cur_month_qty,
        diff_qty,
        create_by,
        create_time
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
            #{item.factoryCode},
            #{item.year},
            #{item.month},
            #{item.materialCode},
            #{item.materialDesc},
            #{item.diffType},
            #{item.prevMonthQty},
            #{item.curMonthQty},
            #{item.diffQty},
            #{item.createBy},
            #{item.createTime}
            )
        </foreach>
    </insert>

</mapper>
