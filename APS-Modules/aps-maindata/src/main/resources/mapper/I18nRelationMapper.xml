<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.maindata.mapper.I18nRelationMapper">

    <select id="selectList" resultType="com.zlt.aps.monthplan.api.domain.entity.I18nRelation">
        select id,MODE_NAME,FILE_NAME,IS_PAGE from T_I18N_RELATION
        <where>
            <if test="isPage != null">
                and IS_PAGE = #{isPage}
            </if>
        </where>
    </select>
</mapper>
