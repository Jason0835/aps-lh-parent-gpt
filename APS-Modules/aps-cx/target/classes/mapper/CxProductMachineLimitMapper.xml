<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.cx.mapper.CxProductMachineLimitMapper">

    <resultMap type="com.zlt.aps.cx.api.domain.entity.CxProductMachineLimit" id="CxProductMachineLimitResult">
        <result property="id" column="id"/>
        <result property="minAvgShift" column="min_avg_shift"/>
        <result property="maxAvgShift" column="max_avg_shift"/>
        <result property="shiftParams" column="shift_params"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectCxProductMachineLimitVo">
        select id, min_avg_shift, max_avg_shift, shift_params, create_by, create_time, update_by, update_time, del_flag, remark from t_cx_product_machine_limit
    </sql>

    <select id="selectCxProductMachineLimitList" parameterType="com.zlt.aps.cx.api.domain.entity.CxProductMachineLimit"
            resultMap="CxProductMachineLimitResult">
        <include refid="selectCxProductMachineLimitVo"/>
        where del_flag = '0'
        <if test="minAvgShift != null ">and min_avg_shift <![CDATA[  >=  ]]> #{minAvgShift}</if>
        <if test="maxAvgShift != null ">and max_avg_shift <![CDATA[  <=  ]]> #{maxAvgShift}</if>
        <if test="shiftParams != null ">and INSTR(shift_params, #{shiftParams}) > 0</if>
        <if test="orderStr == null">
            order by create_time desc
        </if>
        <if test="orderStr != null">
            order by ${orderStr}
        </if>
    </select>

    <select id="checkCxProductMachineLimitUnique" parameterType="com.zlt.aps.cx.api.domain.entity.CxProductMachineLimit"
            resultMap="CxProductMachineLimitResult">
        <include refid="selectCxProductMachineLimitVo"/>
        where del_flag = '0'
        <if test="id != null  and id != ''">and id != #{id}</if>
        AND
        (
        (#{minAvgShift,jdbcType=DOUBLE} <![CDATA[ >= ]]> min_avg_shift  AND #{minAvgShift,jdbcType=DOUBLE} <![CDATA[ < ]]> max_avg_shift )
        OR(#{maxAvgShift,jdbcType=DOUBLE} <![CDATA[ >= ]]> min_avg_shift  AND #{maxAvgShift,jdbcType=DOUBLE} <![CDATA[ < ]]> max_avg_shift )
        OR (#{minAvgShift,jdbcType=DOUBLE} <![CDATA[ >= ]]> min_avg_shift AND #{maxAvgShift,jdbcType=DOUBLE} <![CDATA[ < ]]> max_avg_shift )
        )
    </select>

    <select id="selectCxProductMachineLimitById" parameterType="Long" resultMap="CxProductMachineLimitResult">
        <include refid="selectCxProductMachineLimitVo"/>
        where id = #{id}
    </select>

    <insert id="insertCxProductMachineLimit" parameterType="com.zlt.aps.cx.api.domain.entity.CxProductMachineLimit">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT seq_public.NEXTVAL as id FROM DUAL
        </selectKey>
        insert into t_cx_product_machine_limit
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="minAvgShift != null">min_avg_shift,</if>
            <if test="maxAvgShift != null">max_avg_shift,</if>
            <if test="shiftParams != null">shift_params,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="minAvgShift != null">#{minAvgShift},</if>
            <if test="maxAvgShift != null">#{maxAvgShift},</if>
            <if test="shiftParams != null">#{shiftParams},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateCxProductMachineLimit" parameterType="com.zlt.aps.cx.api.domain.entity.CxProductMachineLimit">
        update t_cx_product_machine_limit
        <trim prefix="SET" suffixOverrides=",">
            <if test="minAvgShift != null">min_avg_shift = #{minAvgShift},</if>
            <if test="maxAvgShift != null">max_avg_shift = #{maxAvgShift},</if>
            <if test="shiftParams != null">shift_params = #{shiftParams},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCxProductMachineLimitById" parameterType="Long">
        update t_cx_product_machine_limit set del_flag='1' where id = #{id}
    </delete>

    <delete id="deleteCxProductMachineLimitByIds" parameterType="String">
        update t_cx_product_machine_limit set del_flag='1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>