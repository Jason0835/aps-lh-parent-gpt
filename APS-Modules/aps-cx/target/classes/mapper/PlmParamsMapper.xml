<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.cx.mapper.PlmParamsMapper">

    <select id="listParams" parameterType="com.zlt.aps.cx.api.domain.entity.PlmConstructionInfo" resultType="com.zlt.aps.cx.api.domain.entity.PlmConstructionInfo">
        select *
        from T_PLM_CONSTRUCTION_INFO
        where 1=1
        <if test="sapCode != null and sapCode != ''">and INSTR(sap_code, #{sapCode}) > 0</if>
        <if test="series != null and series != ''">and series like concat(concat('%', #{series}), '%')</if>
        <if test="code != null and code != ''">and INSTR(code, #{code}) > 0</if>
        <if test="version != null and version != ''">and INSTR(version, #{version}) > 0</if>
        <if test="paramCode != null and paramCode != ''">and INSTR(param_code, #{paramCode}) > 0</if>
        <if test="paramName != null and paramName != ''">and param_name like concat(concat('%', #{paramName}), '%')</if>
        <if test="paramType != null and paramType != ''">and INSTR(param_type, #{paramType}) > 0</if>
        <if test="orderStr == null">
            order by PARAM_TYPE DESC,SERIES
        </if>
        <if test="orderStr != null">
            order by ${orderStr}
        </if>
    </select>
</mapper>