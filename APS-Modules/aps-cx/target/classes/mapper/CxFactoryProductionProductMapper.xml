<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.cx.mapper.CxFactoryProductionProductMapper">

    <resultMap type="com.zlt.aps.cx.api.domain.entity.CxFactoryProductionProduct" id="CxFactoryProductionProductResult">
        <result property="id" column="id"/>
        <result property="year" column="year"/>
        <result property="month" column="month"/>
        <result property="productCode" column="product_code"/>
        <result property="machineCode" column="machine_code"/>
        <result property="companyCode" column="company_code"/>
        <result property="factoryCode" column="factory_code"/>
        <result property="constructionCode" column="construction_code"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectCxFactoryProductionProductVo">
        select id, year, month, product_code, machine_code, company_code, factory_code, construction_code, create_by, create_time, update_by, update_time, del_flag, remark from t_factory_production_product
    </sql>

    <select id="selectCxFactoryProductionProductList"
            parameterType="com.zlt.aps.cx.api.domain.entity.CxFactoryProductionProduct"
            resultMap="CxFactoryProductionProductResult">
        <include refid="selectCxFactoryProductionProductVo"/>
        where del_flag = '0'
        <if test="id != null ">and id = #{id}</if>
        <if test="year != null ">and year = #{year}</if>
        <if test="month != null ">and month = #{month}</if>
        <if test="productCode != null  and productCode != ''">and product_code = #{productCode}</if>
        <if test="machineCode != null  and machineCode != ''">and machine_code = #{machineCode}</if>
        <if test="companyCode != null  and companyCode != ''">and company_code = #{companyCode}</if>
        <if test="factoryCode != null  and factoryCode != ''">and factory_code = #{factoryCode}</if>
        <if test="constructionCode != null  and constructionCode != ''">and construction_code = #{constructionCode}</if>
    </select>

    <select id="selectCxFactoryProductionProductById" parameterType="Long" resultMap="CxFactoryProductionProductResult">
        <include refid="selectCxFactoryProductionProductVo"/>
        where id = #{id}
    </select>

    <insert id="insertCxFactoryProductionProduct"
            parameterType="com.zlt.aps.cx.api.domain.entity.CxFactoryProductionProduct">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT SEQ_factory_production_product.NEXTVAL as id FROM DUAL
        </selectKey>
        insert into t_factory_production_product
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="year != null">year,</if>
            <if test="month != null">month,</if>
            <if test="productCode != null">product_code,</if>
            <if test="machineCode != null">machine_code,</if>
            <if test="companyCode != null">company_code,</if>
            <if test="factoryCode != null">factory_code,</if>
            <if test="constructionCode != null">construction_code,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="year != null">#{year},</if>
            <if test="month != null">#{month},</if>
            <if test="productCode != null">#{productCode},</if>
            <if test="machineCode != null">#{machineCode},</if>
            <if test="companyCode != null">#{companyCode},</if>
            <if test="factoryCode != null">#{factoryCode},</if>
            <if test="constructionCode != null">#{constructionCode},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateCxFactoryProductionProduct"
            parameterType="com.zlt.aps.cx.api.domain.entity.CxFactoryProductionProduct">
        update t_factory_production_product
        <trim prefix="SET" suffixOverrides=",">
            <if test="year != null">year = #{year},</if>
            <if test="month != null">month = #{month},</if>
            <if test="productCode != null">product_code = #{productCode},</if>
            <if test="machineCode != null">machine_code = #{machineCode},</if>
            <if test="companyCode != null">company_code = #{companyCode},</if>
            <if test="factoryCode != null">factory_code = #{factoryCode},</if>
            <if test="constructionCode != null">construction_code = #{constructionCode},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCxFactoryProductionProductById" parameterType="Long">
        update t_factory_production_product set del_flag='1' where id = #{id}
    </delete>

    <delete id="deleteCxFactoryProductionProductByIds" parameterType="String">
        update t_factory_production_product set del_flag='1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


    <delete id="deleteByYearAndMonth">
        update t_factory_production_product set del_flag='1' where year = #{year} and month = #{month} and company_code = '8000' and factory_code = 'L6'
    </delete>
</mapper>