<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.cx.mapper.CxMachineGroupMapper">

    <resultMap type="com.zlt.aps.cx.api.domain.entity.CxMachineGroup" id="CxMachineGroupResult">
        <result property="id" column="id"/>
        <result property="groupName" column="group_name"/>
        <result property="productShift" column="product_shift"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <resultMap id="CxMachineGroupCxMachineGroupListResult" type="com.zlt.aps.cx.api.domain.entity.CxMachineGroup"
               extends="CxMachineGroupResult">
        <collection property="cxMachineGroupListList" notNullColumn="sub_id" javaType="java.util.List"
                    resultMap="CxMachineGroupListResult"/>
    </resultMap>

    <resultMap type="com.zlt.aps.cx.api.domain.entity.CxMachineGroupList" id="CxMachineGroupListResult">
        <result property="id" column="sub_id"/>
        <result property="groupId" column="sub_group_id"/>
        <result property="cxMachineCode" column="sub_cx_machine_code"/>
        <result property="remark" column="sub_remark"/>
        <result property="delFlag" column="sub_del_flag"/>
        <result property="createBy" column="sub_create_by"/>
        <result property="createTime" column="sub_create_time"/>
        <result property="updateBy" column="sub_update_by"/>
        <result property="updateTime" column="sub_update_time"/>
    </resultMap>

    <resultMap type="com.zlt.aps.cx.api.domain.entity.CxMachineGroupForExcel" id="CxMachineGroupForExcelResult">
        <result property="groupName" column="group_name"/>
        <result property="productShift" column="product_shift"/>
        <result property="cxMachineCode" column="cx_machine_code"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectCxMachineGroupVo">
        select id, group_name, product_shift, remark, del_flag, create_by, create_time, update_by, update_time from t_cx_machine_group
    </sql>

    <select id="selectCxMachineGroupList" parameterType="com.zlt.aps.cx.api.domain.entity.CxMachineGroup"
            resultMap="CxMachineGroupResult">
        <include refid="selectCxMachineGroupVo"/>
        where del_flag = '0'
        <if test="groupName != null  and groupName != ''">and group_name like concat(concat('%', #{groupName}), '%')
        </if>
        <if test="productShift != null ">and INSTR(product_shift, #{productShift}) > 0</if>
        <if test="orderStr == null">
            order by create_time desc
        </if>
        <if test="orderStr != null">
            order by ${orderStr}
        </if>
    </select>

    <select id="selectCxMachineGroup4Excel" parameterType="com.zlt.aps.cx.api.domain.entity.CxMachineGroup"
            resultMap="CxMachineGroupForExcelResult">
        select * from (
            select mg.group_name,mg.product_shift,gml.cx_machine_code,mg.remark
            from t_cx_machine_group mg
            left join
            (
              select  ml.group_id,cmi.machine_name as cx_machine_code from t_cx_group_machine_list ml,t_cx_machine_info cmi
              where ml.del_flag = '0' and cmi.del_flag = '0' and ml.cx_machine_code=cmi.machine_code order by ml.create_time desc
            ) gml on mg.id=gml.group_id and mg.del_flag = '0'
            where 1=1
            <if test="groupName != null  and groupName != ''">and mg.group_name like concat(concat('%', #{groupName}), '%')
            </if>
            <if test="productShift != null ">and mg.product_shift = #{productShift}</if>
            <if test="orderStr == null">
                order by mg.create_time desc
            </if>
        ) t
        <if test="orderStr != null">
            order by ${orderStr}
        </if>
    </select>

    <select id="checkCxMachineGroupUnique" parameterType="com.zlt.aps.cx.api.domain.entity.CxMachineGroup"
            resultMap="CxMachineGroupResult">
        <include refid="selectCxMachineGroupVo"/>
        where del_flag = '0'
        <if test="id != null  and id != ''">and id != #{id}</if>
        <if test="groupName != null  and groupName != ''">and group_name=#{groupName}</if>
    </select>

    <select id="selectCxMachineGroupById" parameterType="Long" resultMap="CxMachineGroupCxMachineGroupListResult">
         select a.id, a.group_name, a.product_shift, a.remark, a.del_flag, a.create_by, a.create_time, a.update_by, a.update_time,
             b.id as sub_id, b.group_id as sub_group_id, b.cx_machine_code as sub_cx_machine_code, b.remark as sub_remark, b.del_flag as sub_del_flag, b.create_by as sub_create_by, b.create_time as sub_create_time, b.update_by as sub_update_by, b.update_time as sub_update_time
         from t_cx_machine_group a
         left join t_cx_group_machine_list b on b.group_id = a.id
         where a.id = #{id}
    </select>

    <insert id="insertCxMachineGroup" parameterType="com.zlt.aps.cx.api.domain.entity.CxMachineGroup">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT SEQ_PUBLIC.NEXTVAL as id FROM DUAL
        </selectKey>
        insert into t_cx_machine_group
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="groupName != null">group_name,</if>
            <if test="productShift != null">product_shift,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="groupName != null">#{groupName},</if>
            <if test="productShift != null">#{productShift},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateCxMachineGroup" parameterType="com.zlt.aps.cx.api.domain.entity.CxMachineGroup">
        update t_cx_machine_group
        <trim prefix="SET" suffixOverrides=",">
            <if test="groupName != null">group_name = #{groupName},</if>
            <if test="productShift != null">product_shift = #{productShift},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCxMachineGroupById" parameterType="Long">
        update t_cx_machine_group set del_flag='1' where id = #{id}
    </delete>

    <delete id="deleteCxMachineGroupByIds" parameterType="String">
        update t_cx_machine_group set del_flag='1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteCxMachineGroupListByGroupIds" parameterType="String">
        update t_cx_group_machine_list set del_flag='1' where group_id in
        <foreach item="groupId" collection="array" open="(" separator="," close=")">
            #{groupId}
        </foreach>
    </delete>

    <delete id="deleteCxMachineGroupListByGroupId" parameterType="Long">
          delete from  t_cx_group_machine_list where group_id = #{groupId,jdbcType=DECIMAL}
    </delete>

    <insert id="batchCxMachineGroupList" parameterType="list">
        insert into t_cx_group_machine_list (id, group_id, cx_machine_code, remark, del_flag, create_by,
        create_time,update_by, update_time)
        select SEQ_PUBLIC.NEXTVAL AS ID,x.*
        from (
        <foreach collection="list" item="item" separator=" union ">
            select #{item.groupId,jdbcType=DECIMAL}, #{item.cxMachineCode,jdbcType=VARCHAR},
            #{item.remark,jdbcType=VARCHAR},
            '0', #{item.createBy,jdbcType=VARCHAR}, #{item.createTime,jdbcType=DATE}, #{item.updateBy,jdbcType=VARCHAR},
            #{item.updateTime,jdbcType=DATE} from dual
        </foreach>
        ) x
    </insert>

</mapper>