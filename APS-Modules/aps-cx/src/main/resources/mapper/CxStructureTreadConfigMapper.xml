<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.cx.mapper.CxStructureTreadConfigMapper">

    <select id="selectByUniqueKeyList" resultType="com.zlt.aps.cx.api.domain.entity.CxStructureTreadConfig">
        SELECT
            ID,
            STRUCTURE_CODE,
            FACTORY_CODE
        FROM T_CX_STRUCTURE_TREAD_CONFIG
        WHERE (STRUCTURE_CODE, FACTORY_CODE) IN
        <foreach collection="list" item="item" open="(" separator="," close=")">
            (#{item.structureCode}, #{item.factoryCode})
        </foreach>
    </select>

</mapper>
