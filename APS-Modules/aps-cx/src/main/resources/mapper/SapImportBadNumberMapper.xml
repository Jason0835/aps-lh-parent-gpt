<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.cx.mapper.SapImportBadNumberMapper">

    <resultMap type="com.zlt.aps.cx.api.domain.entity.SapImportBadNumber" id="SapImportBadNumberResult">
        <result property="id" column="id"/>
        <result property="sapCode" column="sap_code"/>
        <result property="badNum" column="bad_num"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectSapImportBadNumberVo">
        select id, sap_code, bad_num, create_by, create_time, update_by, update_time, del_flag, remark from t_sap_import_bad_number
    </sql>

    <select id="selectSapImportBadNumberList" parameterType="com.zlt.aps.cx.api.domain.entity.SapImportBadNumber"
            resultMap="SapImportBadNumberResult">
        <include refid="selectSapImportBadNumberVo"/>
        where del_flag = 0
        <if test="sapCode != null  and sapCode != ''">and INSTR(sap_code, #{sapCode}) > 0</if>
        <if test="orderStr == null">
            order by create_time desc
        </if>
        <if test="orderStr != null">
            order by ${orderStr}
        </if>
    </select>

    <insert id="insertSapImportBadNumber" parameterType="com.zlt.aps.cx.api.domain.entity.SapImportBadNumber">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT SEQ_SAP_IMPORT_BAD_NUMBER.NEXTVAL as id
            FROM DUAL
        </selectKey>
        insert into t_sap_import_bad_number
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="sapCode != null">sap_code,</if>
            <if test="badNum != null">bad_num,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="sapCode != null">#{sapCode},</if>
            <if test="badNum != null">#{badNum},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <delete id="deleteAll">
        update t_sap_import_bad_number
        set del_flag = 1
    </delete>
</mapper>