        LH_STOCK,OVER_TIME_STOCK,SAP_CODE,REMARK,
        DATA_VERSION,CREATE_DATE,UPDATE_DATE,
        IS_DELETE, BOM_DATA_VERSION,AVAILABLE_STOCK
    </sql>

    <sql id="Cx_Sap_Stock_Column_List">
        ID,STOCK_DATE,SAP_CODE,
        STOCK_NUM,PICKED_QTY,REMARK,DATA_VERSION,
        CREATE_DATE,UPDATE_DATE,IS_DELETE
    </sql>

