    <select id="getCxStockByDataVersion" resultMap="CxStockResultMap">
        select
        <include refid="Cx_Stock_Column_List"/>
        from T_MES_CX_STOCK
        where
        data_version = #{dataVersion,jdbcType=VARCHAR}
        AND is_delete = 0
        AND embryo_code IS NOT NULL
        AND bom_data_version IS NOT NULL
    </select>
    <select id="getCxMonthStockByDataVersion" resultMap="CxMonthStockResultMap">
        select
        <include refid="Cx_Month_Stock_Column_List"/>
        from T_MES_CX_MONTH_STOCK
        where
        data_version = #{dataVersion,jdbcType=VARCHAR}
        AND is_delete = 0
        AND embryo_code IS NOT NULL
        AND bom_data_version IS NOT NULL
    </select>
    <select id="getCxSapStockByDataVersion" resultMap="CxSapResultMap">
        select
        <include refid="Cx_Sap_Stock_Column_List"/>
        from T_MES_SAP_STOCK
        where
        data_version = #{dataVersion,jdbcType=VARCHAR}
        AND is_delete = 0
        AND sap_code IS NOT NULL
    </select>

