    <sql id="Cx_Stock_Column_List">
        ID,STOCK_DATE,EMBRYO_CODE,
        STOCK_NUM,LITI_STOCK,EMBRYO_CAR,
        LH_STOCK,OVER_TIME_STOCK,REMARK,
        DATA_VERSION,CREATE_DATE,UPDATE_DATE,
        IS_DELETE,AVAILABLE_STOCK,BOM_DATA_VERSION,UNAVAILABLE_STOCK
    </sql>

    <sql id="Cx_Month_Stock_Column_List">
        ID,STOCK_MONTH,EMBRYO_CODE,
