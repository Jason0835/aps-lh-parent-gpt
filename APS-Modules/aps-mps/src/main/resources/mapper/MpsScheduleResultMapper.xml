<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.mps.mapper.MpsScheduleResultMapper">

    <resultMap type="com.zlt.aps.cx.api.domain.entity.CxScheduleResult" id="CxScheduleResultResult">
