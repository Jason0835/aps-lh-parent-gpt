<mapper namespace="com.zlt.aps.mps.mapper.TAutoScheduleRecordMapper">

    <select id="getLhBatchNoByOrderNo" resultType="com.zlt.aps.lh.api.domain.dto.LhScheduleResultDto">
        WITH temp_table AS (
        <foreach collection="orderNoList" item="orderNo" separator=" union ">
            SELECT #{orderNo} order_no FROM dual
        </foreach>
        )
        select
        *
        from T_LH_SCHEDULE_RESULT
        where  order_no in (select order_no from temp_table) and del_flag = '0'
    </select>
    <select id="getLhCxBatchNoByOrderNo" resultType="java.lang.String">
        select
        CX_BATCH_NO
        from T_LH_AUTO_SCHEDULE_RECORD
        where  LH_BATCH_NO = #{lhBatchNo,jdbcType=VARCHAR} AND DEL_FLAG = '0'
    </select>
