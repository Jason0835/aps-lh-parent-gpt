<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.mps.mapper.CxEngineAutoScheduleRecordMapper">

    <resultMap type="com.zlt.aps.mps.domain.CxEngineAutoScheduleRecord" id="CxEngineAutoScheduleRecordResult">
                    <result property="id"    column="id"    />
                    <result property="monthPlanApsVersion"    column="month_plan_aps_version"    />
                    <result property="cxBatchNo"    column="cx_batch_no"    />
                    <result property="status"    column="status"    />
                    <result property="scheduleDate"    column="schedule_date"    />
                    <result property="createBy"    column="create_by"    />
                    <result property="createTime"    column="create_time"    />
                    <result property="updateBy"    column="update_by"    />
                    <result property="updateTime"    column="update_time"    />
                    <result property="delFlag"    column="del_flag"    />
                    <result property="remark"    column="remark"    />
            </resultMap>
    
    <sql id="selectCxEngineAutoScheduleRecordVo">
        select id, month_plan_aps_version, cx_batch_no, status, schedule_date, create_by, create_time, update_by, update_time, del_flag, remark from t_cx_auto_schedule_record
    </sql>

    <select id="selectCxEngineAutoScheduleRecordList" parameterType="com.zlt.aps.mps.domain.CxEngineAutoScheduleRecord" resultMap="CxEngineAutoScheduleRecordResult">
        <include refid="selectCxEngineAutoScheduleRecordVo"/>
        <where>
            del_flag='0' and status='0'
            <if test="monthPlanApsVersion != null  and monthPlanApsVersion != ''"> and month_plan_aps_version = #{monthPlanApsVersion}</if>
            <if test="cxBatchNo != null  and cxBatchNo != ''"> and cx_batch_no = #{cxBatchNo}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="scheduleDate != null "> and schedule_date = #{scheduleDate}</if>
        </where>
    </select>

    <select id="selectCxEngineAutoScheduleRecordById" parameterType="Long" resultMap="CxEngineAutoScheduleRecordResult">
                    <include refid="selectCxEngineAutoScheduleRecordVo"/>
            where id = #{id}
            </select>

    <insert id="insertCxEngineAutoScheduleRecord" parameterType="com.zlt.aps.mps.domain.CxEngineAutoScheduleRecord">
                    <selectKey keyProperty="id" resultType="long" order="BEFORE">
                SELECT seq_t_cx_auto_schedule_record.NEXTVAL as id FROM DUAL
            </selectKey>
                insert into t_cx_auto_schedule_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
                            <if test="id != null">id,</if>
                            <if test="monthPlanApsVersion != null">month_plan_aps_version,</if>
                            <if test="cxBatchNo != null">cx_batch_no,</if>
                            <if test="status != null">status,</if>
                            <if test="scheduleDate != null">schedule_date,</if>
                            <if test="createBy != null">create_by,</if>
                            <if test="createTime != null">create_time,</if>
                            <if test="updateBy != null">update_by,</if>
                            <if test="updateTime != null">update_time,</if>
                            <if test="delFlag != null">del_flag,</if>
                            <if test="remark != null">remark,</if>
                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                            <if test="id != null">#{id},</if>
                            <if test="monthPlanApsVersion != null">#{monthPlanApsVersion},</if>
                            <if test="cxBatchNo != null">#{cxBatchNo},</if>
                            <if test="status != null">#{status},</if>
                            <if test="scheduleDate != null">#{scheduleDate},</if>
                            <if test="createBy != null">#{createBy},</if>
                            <if test="createTime != null">#{createTime},</if>
                            <if test="updateBy != null">#{updateBy},</if>
                            <if test="updateTime != null">#{updateTime},</if>
                            <if test="delFlag != null">#{delFlag},</if>
                            <if test="remark != null">#{remark},</if>
                    </trim>
    </insert>

    <update id="updateCxEngineAutoScheduleRecord" parameterType="com.zlt.aps.mps.domain.CxEngineAutoScheduleRecord">
        update t_cx_auto_schedule_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="monthPlanApsVersion != null">month_plan_aps_version = #{monthPlanApsVersion},</if>
            <if test="cxBatchNo != null">cx_batch_no = #{cxBatchNo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="scheduleDate != null">schedule_date = #{scheduleDate},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCxEngineAutoScheduleRecordById" parameterType="Long">
        update t_cx_auto_schedule_record set del_flag='1' where id = #{id}
    </delete>

    <!--根据排程日期进行抓取记录删除-->
    <delete id="deleteAutoScheduleRecordByScheduleDate" parameterType="String">
        update t_cx_auto_schedule_record set del_flag='1' where schedule_date = to_date(#{scheduleDate},'yyyy-mm-dd')
    </delete>

    <delete id="deleteCxEngineAutoScheduleRecordByIds" parameterType="String">
        update t_cx_auto_schedule_record set del_flag='1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!--查询最新的排程抓取记录-->
    <select id="selectAutoScheduleRecordByScheduleDate" parameterType="String" resultMap="CxEngineAutoScheduleRecordResult">
        <include refid="selectCxEngineAutoScheduleRecordVo"/>
        where del_flag='0' and status='0'
        and schedule_date = to_date(#{scheduleDate},'yyyy-mm-dd')
    </select>
    <select id="selectOneByCxBatch" resultMap="CxEngineAutoScheduleRecordResult">
        <include refid="selectCxEngineAutoScheduleRecordVo"/>
        where
        cx_batch_no = #{cxBatchNo,jdbcType=VARCHAR}
        AND status = '0'
        AND del_flag = '0'
    </select>

</mapper>