<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.mp.mdm.mapper.FactoryNoProductionMapper">

    <resultMap type="com.zlt.aps.mp.api.domain.entity.FactoryNoProduction" id="FactoryNoProductionResult">
        <result property="id" column="ID"/>
        <result property="factoryCode" column="FACTORY_CODE"/>
        <result property="year" column="YEAR"/>
        <result property="month" column="MONTH"/>
        <result property="materialCode" column="MATERIAL_CODE"/>
        <result property="productTypeName" column="PRODUCT_TYPE_NAME"/>
        <result property="materialDesc" column="MATERIAL_DESC"/>
        <result property="remark" column="REMARK"/>
        <result property="isDelete" column="IS_DELETE"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="updateTime" column="UPDATE_TIME"/>
        <result property="createBy" column="CREATE_BY"/>
        <result property="updateBy" column="UPDATE_BY"/>
    </resultMap>


    <select id="selectFactoryNoProductionList" parameterType="com.zlt.aps.mp.api.domain.entity.FactoryNoProduction" resultMap="FactoryNoProductionResult">
        SELECT
        fnp.ID,
        fnp.FACTORY_CODE,
        fnp.YEAR,
        fnp.MONTH,
        fnp.MATERIAL_CODE,
        pi.PRODUCT_TYPE_NAME,
        fnp.MATERIAL_DESC,
        fnp.REMARK,
        fnp.IS_DELETE,
        fnp.CREATE_TIME,
        fnp.UPDATE_TIME,
        fnp.CREATE_BY,
        fnp.UPDATE_BY
        FROM
        T_MDM_FACTORY_NO_PRODUCTION fnp
        LEFT JOIN t_mdm_material_info pi ON fnp.MATERIAL_CODE = pi.MATERIAL_CODE
        WHERE
        fnp.IS_DELETE = 0
        <if test="factoryCode != null  and factoryCode != ''"> AND fnp.FACTORY_CODE = #{factoryCode}</if>
        <if test="year != null "> AND fnp.YEAR = #{year}</if>
        <if test="month != null "> AND fnp.MONTH = #{month}</if>
        <if test="materialCode != null  and materialCode != ''">AND fnp.MATERIAL_CODE like CONCAT('%',
            #{productCode},'%')
        </if>
        <if test="materialDesc != null  and materialDesc != ''">AND fnp.MATERIAL_DESC = like CONCAT('%',
            #{materialDesc},'%')
        </if>
    </select>
</mapper>
