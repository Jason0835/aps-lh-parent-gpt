<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.tq.mapper.TqImportLogManagementMapper">

    <!-- 通用查询映射结果 -->
    <select id="listImportLogManagement" parameterType="com.zlt.aps.tq.api.domain.dto.TqImportLogManagementDto" resultType="com.zlt.aps.tq.api.domain.dto.TqImportLogManagementDto">
        select *
        from T_IMPORT_LOG
        where DEL_FLAG = 0
        and PROCEDURE_CODE = '5'
        <if test="functionName != null and functionName != ''">
            and FUNCTION_NAME LIKE concat(concat('%',#{functionName}), '%')
        </if>
        <if test="fileName != null and fileName != ''">
            and FILE_NAME LIKE concat(concat('%',#{fileName}), '%')
        </if>
        <if test="orderStr == null">
            order by create_time desc
        </if>
        <if test="orderStr != null">
            order by ${orderStr}
        </if>

    </select>

</mapper>
