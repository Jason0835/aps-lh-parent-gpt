<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.tm.mapper.TmImportErrorLogManagementMapper">

    <!-- 通用查询映射结果 -->
    <select id="listImportErrorLogManagement" parameterType="com.zlt.aps.tm.api.domain.dto.TmImportErrorLogManagementDto" resultType="com.zlt.aps.tm.api.domain.dto.TmImportErrorLogManagementDto">
        select *
        from T_IMPORT_ERROR_LOG
        where DEL_FLAG = 0
        and IMPORT_LOG_ID = #{importLogId}
        <if test="errorRow != null and errorRow != ''">
            and ERROR_ROW = #{errorRow}
        </if>
        <if test="errorDetail != null and errorDetail != ''">
            and error_Detail  like concat(concat('%', #{errorDetail}), '%')
        </if>
        order by ERROR_ROW
    </select>

</mapper>
