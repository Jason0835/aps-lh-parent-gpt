<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.mdm.auth.mapper.MdmSystemAuthMapper">

        <resultMap type="com.zlt.mdm.auth.api.domain.vo.UserSystemVo" id="UserSystemVoResult">
            <id property="userId" column="user_id"/>
            <collection property="systems" javaType="java.util.List" resultMap="MdmSystemDataResult"/>
        </resultMap>

    <resultMap type="com.zlt.mdm.auth.api.domain.MdmSystemData" id="MdmSystemDataResult">
        <id property="systemId" column="system_id"/>
        <result property="systemCode" column="system_code"/>
        <result property="langJson" column="lang_json"/>
        <result property="orderNum" column="order_num"/>
        <result property="url" column="url"/>
        <result property="icon" column="icon"/>
        <result property="target" column="target"/>
        <result property="parentId" column="parent_id"/>

        <result property="delFlag" column="del_flag"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

        <select id="selectSystemDatasByUserId" parameterType="Long" resultMap="UserSystemVoResult">
            select t.user_id,d.* from
            mdm_sys_auth t, mdm_system_data d
            where d.system_id = t.system_id
                and t.user_id = #{userId}
                and del_flag = 0 and status = 0
        </select>

    <select id="selectSystemDataList" resultMap="MdmSystemDataResult" >
        select * from mdm_system_data
        where del_flag = 0 and status = 0
        order by order_num asc
    </select>
</mapper>