<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.maindata.mapper.MdmTreadStockEntityMapper">

    <resultMap id="BaseResultMap" type="com.zlt.aps.mp.api.domain.entity.MdmTreadStock">
        <id column="ID" property="id"/>
        <result column="STOCK_DATE" property="stockDate"/>
        <result column="MATERIAL_CODE" property="materialCode"/>
        <result column="AVAILABLE_STOCK" property="availableStock"/>
        <result column="DATA_VERSION" property="dataVersion"/>
        <result column="COMPANY_CODE" property="companyCode"/>
        <result column="FACTORY_CODE" property="factoryCode"/>
        <result column="IS_DELETE" property="isDelete"/>
        <result column="CREATE_BY" property="createBy"/>
        <result column="CREATE_TIME" property="createTime"/>
        <result column="UPDATE_BY" property="updateBy"/>
        <result column="UPDATE_TIME" property="updateTime"/>
        <result column="REMARK" property="remark"/>
    </resultMap>

    <select id="selectByUniqueKey" resultMap="BaseResultMap">
        SELECT
            ID, STOCK_DATE, MATERIAL_CODE, AVAILABLE_STOCK, DATA_VERSION,
            COMPANY_CODE, FACTORY_CODE, IS_DELETE,
            CREATE_BY, CREATE_TIME, UPDATE_BY, UPDATE_TIME, REMARK
        FROM T_MDM_TREAD_STOCK
        WHERE STOCK_DATE = #{stockDate}
          AND MATERIAL_CODE = #{materialCode}
          AND FACTORY_CODE = #{factoryCode}
    </select>

    <select id="selectByUniqueKeyList" resultMap="BaseResultMap">
        SELECT
            ID, STOCK_DATE, MATERIAL_CODE, AVAILABLE_STOCK, DATA_VERSION,
            COMPANY_CODE, FACTORY_CODE, IS_DELETE,
            CREATE_BY, CREATE_TIME, UPDATE_BY, UPDATE_TIME, REMARK
        FROM T_MDM_TREAD_STOCK
        WHERE (STOCK_DATE, MATERIAL_CODE, FACTORY_CODE) IN
        <foreach collection="list" item="item" open="(" separator="," close=")">
            (#{item.stockDate}, #{item.materialCode}, #{item.factoryCode})
        </foreach>
    </select>

</mapper>
