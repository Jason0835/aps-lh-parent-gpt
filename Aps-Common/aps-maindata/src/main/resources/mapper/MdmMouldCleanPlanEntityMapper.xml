<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.maindata.mapper.MdmMouldCleanPlanEntityMapper">

    <select id="selectByUniqueKeyList" resultType="com.zlt.aps.mdm.api.domain.entity.MdmMouldCleanWarn">
        SELECT
            ID,
            LH_CODE,
            FACTORY_CODE
        FROM T_MDM_MOULD_CLEAN_PLAN
        WHERE (LH_CODE, FACTORY_CODE) IN
        <foreach collection="list" item="item" open="(" separator="," close=")">
            (#{item.lhCode}, #{item.factoryCode})
        </foreach>
    </select>

</mapper>
