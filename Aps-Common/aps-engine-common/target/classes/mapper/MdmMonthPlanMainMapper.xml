<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.common.engine.mapper.MdmMonthPlanMainMapper">

    <resultMap type="com.zlt.aps.common.engine.domain.MdmMonthPlanMain" id="MdmMonthPlanMainResult">
                    <result property="id"    column="id"    />
                    <result property="monthPlanApsVersion"    column="month_plan_aps_version"    />
                    <result property="monthPlanVersion"    column="month_plan_version"    />
                    <result property="year"    column="year"    />
                    <result property="month"    column="month"    />
                    <result property="isFinalized"    column="is_finalized"    />
                    <result property="createBy"    column="create_by"    />
                    <result property="createTime"    column="create_time"    />
                    <result property="updateBy"    column="update_by"    />
                    <result property="updateTime"    column="update_time"    />
                    <result property="delFlag"    column="del_flag"    />
                    <result property="remark"    column="remark"    />
            </resultMap>
    
    <sql id="selectMdmMonthPlanMainVo">
        select id, month_plan_aps_version, month_plan_version, year, month, is_finalized, create_by, create_time, update_by, update_time, del_flag, remark from t_mdm_month_plan_main
    </sql>

    <select id="selectMdmMonthPlanMainList" parameterType="com.zlt.aps.common.engine.domain.MdmMonthPlanMain" resultMap="MdmMonthPlanMainResult">
        <include refid="selectMdmMonthPlanMainVo"/>
        <where>
          del_flag='0'
         <if test="monthPlanApsVersion != null  and monthPlanApsVersion != ''"> and month_plan_aps_version = #{monthPlanApsVersion}</if>
         <if test="monthPlanVersion != null  and monthPlanVersion != ''"> and month_plan_version = #{monthPlanVersion}</if>
         <if test="year != null  and year != ''"> and year = #{year}</if>
         <if test="month != null  and month != ''"> and month = #{month}</if>
         <if test="isFinalized != null  and isFinalized != ''"> and is_finalized = #{isFinalized}</if>
        </where>
    </select>

    <select id="selectMdmMonthPlanMainById" parameterType="Long" resultMap="MdmMonthPlanMainResult">
                    <include refid="selectMdmMonthPlanMainVo"/>
            where id = #{id}
            </select>

    <select id="getValidPlanMainVersion" parameterType="com.zlt.aps.common.engine.domain.MdmMonthPlanMain" resultMap="MdmMonthPlanMainResult">
        <include refid="selectMdmMonthPlanMainVo"/>
        <where>
            del_flag='0'
            <if test="monthPlanApsVersion != null  and monthPlanApsVersion != ''"> and month_plan_aps_version = #{monthPlanApsVersion}</if>
            <if test="monthPlanVersion != null  and monthPlanVersion != ''"> and month_plan_version = #{monthPlanVersion}</if>
            <if test="year != null  and year != ''"> and year = #{year}</if>
            <if test="month != null  and month != ''"> and month = #{month}</if>
            <if test="isFinalized != null  and isFinalized != ''"> and is_finalized = #{isFinalized}</if>
            and ROWNUM <![CDATA[   <=  ]]> 1
        </where>
    </select>

    <insert id="insertMdmMonthPlanMain" parameterType="com.zlt.aps.common.engine.domain.MdmMonthPlanMain">
                    <selectKey keyProperty="id" resultType="long" order="BEFORE">
                SELECT seq_t_mdm_month_plan_main.NEXTVAL as id FROM DUAL
            </selectKey>
                insert into t_mdm_month_plan_main
        <trim prefix="(" suffix=")" suffixOverrides=",">
                            <if test="id != null">id,</if>
                            <if test="monthPlanApsVersion != null">month_plan_aps_version,</if>
                            <if test="monthPlanVersion != null">month_plan_version,</if>
                            <if test="year != null">year,</if>
                            <if test="month != null">month,</if>
                            <if test="isFinalized != null">is_finalized,</if>
                            <if test="createBy != null">create_by,</if>
                            <if test="createTime != null">create_time,</if>
                            <if test="updateBy != null">update_by,</if>
                            <if test="updateTime != null">update_time,</if>
                            <if test="delFlag != null">del_flag,</if>
                            <if test="remark != null">remark,</if>
                    </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                            <if test="id != null">#{id},</if>
                            <if test="monthPlanApsVersion != null">#{monthPlanApsVersion},</if>
                            <if test="monthPlanVersion != null">#{monthPlanVersion},</if>
                            <if test="year != null">#{year},</if>
                            <if test="month != null">#{month},</if>
                            <if test="isFinalized != null">#{isFinalized},</if>
                            <if test="createBy != null">#{createBy},</if>
                            <if test="createTime != null">#{createTime},</if>
                            <if test="updateBy != null">#{updateBy},</if>
                            <if test="updateTime != null">#{updateTime},</if>
                            <if test="delFlag != null">#{delFlag},</if>
                            <if test="remark != null">#{remark},</if>
                    </trim>
    </insert>

    <update id="updateMdmMonthPlanMain" parameterType="com.zlt.aps.common.engine.domain.MdmMonthPlanMain">
        update t_mdm_month_plan_main
        <trim prefix="SET" suffixOverrides=",">
            <if test="monthPlanApsVersion != null">month_plan_aps_version = #{monthPlanApsVersion},</if>
            <if test="monthPlanVersion != null">month_plan_version = #{monthPlanVersion},</if>
            <if test="year != null">year = #{year},</if>
            <if test="month != null">month = #{month},</if>
            <if test="isFinalized != null">is_finalized = #{isFinalized},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMdmMonthPlanMainById" parameterType="Long">
        update T_MDM_MONTH_PLAN_MAIN set del_flag='1' where id = #{id}
    </delete>

    <delete id="deleteByApsVersion">
        update T_MDM_MONTH_PLAN_MAIN
        set
        DEL_FLAG =  1
        where
        month_plan_aps_version = #{monthPlanApsVersion,jdbcType=VARCHAR}
    </delete>

    <delete id="deleteByYearAndMonthAndIsFinal">
        update T_MDM_MONTH_PLAN_MAIN
        set
            DEL_FLAG =  1
        where
         year = #{year,jdbcType=VARCHAR}
          AND month = #{month,jdbcType=VARCHAR}
          AND is_finalized = #{isFinal,jdbcType=VARCHAR}
    </delete>

    <delete id="deleteMdmMonthPlanMainByIds" parameterType="String">
        update t_mdm_month_plan_main set del_flag='1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <insert id="insertAll">
        insert into t_mdm_month_plan_main
        (id,month_plan_aps_version,month_plan_version,
        year,month,is_finalized,
        remark,del_flag,create_by,
        create_time,update_by,update_time)
        values
        (
        T_MDM_MONTH_PLAN_MAIN_SEQ.NEXTVAL,#{monthPlanApsVersion,jdbcType=VARCHAR},#{monthPlanVersion,jdbcType=VARCHAR},
        #{year,jdbcType=VARCHAR},#{month,jdbcType=VARCHAR},#{isFinalized,jdbcType=VARCHAR},
        #{remark,jdbcType=VARCHAR},#{delFlag,jdbcType=VARCHAR},#{createBy,jdbcType=VARCHAR},
        #{createTime,jdbcType=TIMESTAMP},#{updateBy,jdbcType=VARCHAR},#{updateTime,jdbcType=TIMESTAMP}
        )
    </insert>

    <!--Joran 2021-12-04 重算主版本表中最新的版本所对应的月度汇总重算-->
    <select id="selectNewestPlanMain" resultMap="MdmMonthPlanMainResult">
       select * from (
              select month_plan_aps_version,max(create_time) create_time from t_mdm_month_plan_main mmpm where mmpm.del_flag='0' and mmpm.is_finalized='0'
              group by month_plan_aps_version
              order by create_time desc
        ) t where rownum=1
    </select>
    <!--Joran 2021-12-04 重算主版本表中最新的版本所对应的月度汇总重算-->

</mapper>