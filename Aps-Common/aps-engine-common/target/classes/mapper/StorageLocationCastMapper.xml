<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.common.engine.mapper.StorageLocationCastMapper">

    <resultMap type="com.zlt.aps.common.engine.domain.StorageLocationCast" id="StorageLocationCastResult">
                    <result property="id" column="id"/>
                    <result property="apsStorageLocation" column="aps_storage_location"/>
                    <result property="mpsStorageLocation" column="mps_storage_location"/>
                    <result property="tireStoreType" column="tire_store_type"/>
                    <result property="createBy" column="create_by"/>
                    <result property="createTime" column="create_time"/>
                    <result property="updateBy" column="update_by"/>
                    <result property="updateTime" column="update_time"/>
                    <result property="delFlag" column="del_flag"/>
                    <result property="remark" column="remark"/>
            </resultMap>
    
    <sql id="selectStorageLocationCastVo">
        select id, aps_storage_location, mps_storage_location, tire_store_type, create_by, create_time, update_by, update_time, del_flag, remark from t_storage_location_cast
    </sql>

    <select id="selectStorageLocationCastList" parameterType="com.zlt.aps.common.engine.domain.StorageLocationCast" resultMap="StorageLocationCastResult">
        <include refid="selectStorageLocationCastVo"/>
        <where>
            del_flag = '0'
            <if test="apsStorageLocation != null  and apsStorageLocation != ''"> and aps_storage_location = #{apsStorageLocation}</if>
            <if test="mpsStorageLocation != null  and mpsStorageLocation != ''"> and mps_storage_location = #{mpsStorageLocation}</if>
            <if test="tireStoreType != null  and tireStoreType != ''"> and tire_store_type = #{tireStoreType}</if>
        </where>
      order by create_time desc
    </select>

    <select id="selectStorageLocationCastById" parameterType="Long" resultMap="StorageLocationCastResult">
                    <include refid="selectStorageLocationCastVo"/>
            where id = #{id}
    </select>
</mapper>