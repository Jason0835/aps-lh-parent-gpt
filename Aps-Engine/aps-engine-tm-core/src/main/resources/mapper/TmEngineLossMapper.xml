<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.tm.engine.mapper.TmEngineLossMapper">

    <select id="listLossRate" parameterType="string" resultType="com.zlt.aps.tm.engine.vo.TmLossVo">
        select nvl(machine_id,'') || '#' || nvl(tread_code,'') LOSS_KEY, LOSS_RATE
        from T_TM_LOSS_SETTING
        where DEL_FLAG = 0
    </select>

</mapper>
