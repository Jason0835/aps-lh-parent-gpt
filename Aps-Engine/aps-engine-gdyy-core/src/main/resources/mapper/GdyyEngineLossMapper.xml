<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.gdyy.engine.mapper.GdyyEngineLossMapper">
	<!-- 查询损耗率配置信息 -->
    <select id="listLossRate" parameterType="string" resultType="com.zlt.aps.gdyy.engine.vo.GdyyLossSettingVo">
        select BIG_ROLL_CODE, LOSS_RATE
        from T_GDYY_LOSS_SETTING
        where DEL_FLAG = 0
    </select>

</mapper>
