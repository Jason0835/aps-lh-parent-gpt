<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.gdyy.engine.mapper.GdyyEngineBigRollMapper">
    <select id="listCd15BigRoll" resultType="com.zlt.aps.gdyy.engine.vo.GdyyBigRollVo">
        SELECT BIG_ROLL_CODE,
               IFNULL(MAX(ACT_CLOTH_LENGTH), 0) CLOTH_LENGTH
          FROM T_CD15_BIG_ROLL
         WHERE DEL_FLAG = '0'
         GROUP BY BIG_ROLL_CODE
    </select>
</mapper>
