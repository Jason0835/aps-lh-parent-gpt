<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.cx.engine.mapper.CxAutoScheduleTaskMapper">

    <resultMap type="com.zlt.aps.cx.engine.domain.CxAutoScheduleTask" id="CxAutoScheduleTaskResult">
                    <result property="id"    column="id"    />
                    <result property="cxOrderNo"    column="cx_order_no"    />
                    <result property="scheduleDate"    column="schedule_date"    />
                    <result property="classShift"    column="class_shift"    />
                    <result property="cxMachineCode"    column="cx_machine_code"    />
                    <result property="embryoCode"    column="embryo_code"    />
                    <result property="taskTotalQty"    column="task_total_qty"    />
                    <result property="remainTaskQty"    column="remain_task_qty"    />
                    <result property="currentShiftPlanQty"    column="current_shift_plan_qty"    />
                    <result property="status"    column="status"    />
                    <result property="createBy"    column="create_by"    />
                    <result property="createTime"    column="create_time"    />
                    <result property="updateBy"    column="update_by"    />
                    <result property="updateTime"    column="update_time"    />
                    <result property="delFlag"    column="del_flag"    />
                    <result property="remark"    column="remark"    />
            </resultMap>
    
    <sql id="selectCxAutoScheduleTaskVo">
        select id, cx_order_no, schedule_date, class_shift, cx_machine_code, embryo_code, task_total_qty, remain_task_qty, current_shift_plan_qty, status, create_by, create_time, update_by, update_time, del_flag, remark from t_cx_auto_schedule_task
    </sql>

    <select id="selectCxAutoScheduleTaskList" parameterType="com.zlt.aps.cx.engine.domain.CxAutoScheduleTask"
            resultMap="CxAutoScheduleTaskResult">
        <include refid="selectCxAutoScheduleTaskVo"/>
        where del_flag = 0
        <if test="cxOrderNo != null  and cxOrderNo != ''">and cx_order_no =#{cxOrderNo} </if>
        <if test="scheduleDate != null  and scheduleDate != ''">and schedule_date =#{scheduleDate} </if>
        <if test="status != null  and status != ''">and status =#{status} </if>
        <if test="cxMachineCode != null  and cxMachineCode != ''">and cx_machine_code =#{cxMachineCode} </if>
        <if test="embryoCode != null  and embryoCode != ''">and embryo_code =#{embryoCode} </if>
    </select>


    <insert id="insertCxAutoScheduleTaskList" parameterType="com.zlt.aps.cx.engine.domain.CxAutoScheduleTask">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT seq_t_cx_auto_schedule_task.NEXTVAL as id FROM DUAL
        </selectKey>
        insert into t_cx_auto_schedule_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="cxOrder != null">cx_order_no,</if>
            <if test="scheduleDate != null">schedule_date,</if>
            <if test="classShift != null">class_shift,</if>
            <if test="cxMachineCode != null">cx_machine_code,</if>
            <if test="embryoCode != null">embryo_code,</if>
            <if test="taskTotalQty != null">task_total_qty,</if>
            <if test="remainTaskQty != null">remain_task_qty,</if>
            <if test="currentShiftPlanQty != null">current_shift_plan_qty,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="cxOrderNo != null">#{cxOrderNo},</if>
            <if test="scheduleDate != null">#{scheduleDate},</if>
            <if test="classShift != null">#{classShift},</if>
            <if test="cxMachineCode != null">#{cxMachineCode},</if>
            <if test="embryoCode != null">#{embryoCode},</if>
            <if test="taskTotalQty != null">#{taskTotalQty},</if>
            <if test="remainTaskQty != null">#{remainTaskQty},</if>
            <if test="currentShiftPlanQty != null">#{currentShiftPlanQty},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateCxAutoScheduleTask" parameterType="com.zlt.aps.cx.engine.domain.CxAutoScheduleTask">
        update t_cx_auto_schedule_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="cxOrderNo != null">cx_order_no = #{cxOrderNo},</if>
            <if test="scheduleDate != null">schedule_date = #{scheduleDate},</if>
            <if test="classShift != null">class_shift = #{classShift},</if>
            <if test="cxMachineCode != null">cx_machine_code = #{cxMachineCode},</if>
            <if test="embryoCode != null">embryo_code = #{embryoCode},</if>
            <if test="taskTotalQty != null">task_total_qty = #{taskTotalQty},</if>
            <if test="remainTaskQty != null">remain_task_qty = #{remainTaskQty},</if>
            <if test="currentShiftPlanQty != null">current_shift_plan_qty = #{currentShiftPlanQty},</if>
            <if test="status != null">status =#{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCxAutoScheduleTaskById" parameterType="Long">
        update t_cx_auto_schedule_task set del_flag='1' where id = #{id}
    </delete>

    <delete id="deleteCxAutoScheduleTaskByIds" parameterType="String">
        update t_cx_auto_schedule_task set del_flag='1'
        where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>


    </mapper>