<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.cx.engine.mapper.CxEngineLossSettingMapper">

    <resultMap type="com.zlt.aps.cx.engine.domain.CxEngineLossSetting" id="CxEngineLossSettingResult">
                    <result property="id"    column="id"    />
                    <result property="embryoCode"    column="embryo_code"    />
                    <result property="machineCode"    column="machine_code"    />
                    <result property="lossRate"    column="loss_rate"    />
                    <result property="createBy"    column="create_by"    />
                    <result property="createTime"    column="create_time"    />
                    <result property="updateBy"    column="update_by"    />
                    <result property="updateTime"    column="update_time"    />
                    <result property="delFlag"    column="del_flag"    />
                    <result property="remark"    column="remark"    />
            </resultMap>
    
    <sql id="selectCxEngineLossSettingVo">
        select id, embryo_code, machine_code, loss_rate, create_by, create_time, update_by, update_time, del_flag, remark from t_cx_loss_setting
    </sql>

    <select id="selectCxEngineLossSettingList" parameterType="com.zlt.aps.cx.engine.domain.CxEngineLossSetting" resultMap="CxEngineLossSettingResult">
        <include refid="selectCxEngineLossSettingVo"/>
        <where>
            del_flag='0'
            <if test="embryoCode != null  and embryoCode != ''"> and embryo_code = #{embryoCode}</if>
            <if test="machineCode != null "> and machine_code = #{machineCode}</if>
            <if test="lossRate != null "> and loss_rate = #{lossRate}</if>
        </where>
    </select>

    <select id="selectCxEngineLossSettingById" parameterType="Long" resultMap="CxEngineLossSettingResult">
                    <include refid="selectCxEngineLossSettingVo"/>
            where id = #{id}
            </select>

    <update id="updateCxEngineLossSetting" parameterType="com.zlt.aps.cx.engine.domain.CxEngineLossSetting">
        update t_cx_loss_setting
        <trim prefix="SET" suffixOverrides=",">
            <if test="embryoCode != null">embryo_code = #{embryoCode},</if>
            <if test="machineCode != null">machine_code = #{machineCode},</if>
            <if test="lossRate != null">loss_rate = #{lossRate},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCxEngineLossSettingById" parameterType="Long">
        update t_cx_loss_setting set del_flag='1' where id = #{id}
    </delete>

    <delete id="deleteCxEngineLossSettingByIds" parameterType="String">
        update t_cx_loss_setting set del_flag='1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    </mapper>