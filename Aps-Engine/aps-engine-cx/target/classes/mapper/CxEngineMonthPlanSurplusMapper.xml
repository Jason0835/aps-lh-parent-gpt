<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.cx.engine.mapper.CxEngineMonthPlanSurplusMapper">

    <resultMap type="com.zlt.aps.cx.engine.domain.CxEngineMonthPlanSurplus" id="CxEngineMonthPlanSurplusResult">
                    <result property="id"    column="id"    />
                    <result property="monthPlanApsVersion"    column="month_plan_aps_version"    />
                    <result property="monthPlanVersion"    column="month_plan_version"    />
                    <result property="year"    column="year"    />
                    <result property="month"    column="month"    />
                    <result property="sapCode"    column="sap_code"    />
                    <result property="embryoCode"    column="embryo_code"    />
                    <result property="dataSource"    column="data_source"    />
                    <result property="lastMonthStock" column="last_month_stock" />
                    <result property="sapBadQty" column="sap_bad_qty" />
                    <result property="monthPlanQty"    column="month_plan_qty"    />
                    <result property="planModifyQty"    column="plan_modify_qty"    />
                    <result property="monthFinishQty"    column="month_finish_qty"    />
                    <result property="monthRemainQty"    column="month_remain_qty"    />
                    <result property="createBy"    column="create_by"    />
                    <result property="createTime"    column="create_time"    />
                    <result property="updateBy"    column="update_by"    />
                    <result property="updateTime"    column="update_time"    />
                    <result property="delFlag"    column="del_flag"    />
                    <result property="remark"    column="remark"    />
            </resultMap>
    
    <sql id="selectCxMonthPlanSurplusVo">
        select id, month_plan_aps_version, month_plan_version, year, month, sap_code,embryo_code, month_plan_qty, plan_modify_qty, month_finish_qty, month_remain_qty,data_source,last_month_stock,sap_bad_qty,
                create_by, create_time, update_by, update_time, del_flag, remark from t_cx_month_plan_surplus
    </sql>

    <select id="selectCxMonthPlanSurplusList" parameterType="com.zlt.aps.cx.engine.domain.CxEngineMonthPlanSurplus" resultMap="CxEngineMonthPlanSurplusResult">
        <include refid="selectCxMonthPlanSurplusVo"/>
        <where>
              del_flag='0'
            <if test="monthPlanApsVersion != null  and monthPlanApsVersion != ''"> and month_plan_aps_version = #{monthPlanApsVersion}</if>
            <if test="year != null  and year != ''"> and year = #{year}</if>
            <if test="month != null  and month != ''"> and month = #{month}</if>
            <if test="sapCode != null  and sapCode != ''"> and sap_code = #{sapCode}</if>
            <if test="embryoCode != null  and embryoCode != ''"> and embryo_code = #{embryoCode}</if>
            <if test="cxBatchNo != null  and cxBatchNo != ''"> and month_plan_aps_version = (select month_plan_aps_version from T_CX_AUTO_SCHEDULE_RECORD t where t.cx_batch_no=#{cxBatchNo})</if>
            <if test="isCloseOut">
                and month_remain_qty <![CDATA[   <=  ]]> 0
            </if>
        </where>
    </select>

    <insert id="insertCxMonthPlanSurplus" parameterType="com.zlt.aps.cx.engine.domain.CxEngineMonthPlanSurplus">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT T_CX_MONTH_PLAN_SURPLUS_SEQ.NEXTVAL as id FROM DUAL
        </selectKey>
        insert into t_cx_month_plan_surplus
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="monthPlanApsVersion != null">month_plan_aps_version,</if>
            <if test="monthPlanVersion != null">month_plan_version,</if>
            <if test="year != null">year,</if>
            <if test="month != null">month,</if>
            <if test="sapCode != null">sap_code,</if>
            <if test="embryoCode != null">embryo_code,</if>
            <if test="monthPlanQty != null">month_plan_qty,</if>
            <if test="planModifyQty != null">plan_modify_qty,</if>
            <if test="monthFinishQty != null">month_finish_qty,</if>
            <if test="monthRemainQty != null">month_remain_qty,</if>
            <if test="dataSource != null">data_source,</if>
            <if test="lastMonthStock != null">last_month_stock,</if>
            <if test="sapBadQty != null">sap_bad_qty,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="monthPlanApsVersion != null">#{monthPlanApsVersion},</if>
            <if test="monthPlanVersion != null">#{monthPlanVersion},</if>
            <if test="year != null">#{year},</if>
            <if test="month != null">#{month},</if>
            <if test="sapCode != null">#{sapCode},</if>
            <if test="embryoCode != null">#{embryoCode},</if>
            <if test="monthPlanQty != null">#{monthPlanQty},</if>
            <if test="planModifyQty != null">#{planModifyQty},</if>
            <if test="monthFinishQty != null">#{monthFinishQty},</if>
            <if test="monthRemainQty != null">#{monthRemainQty},</if>
            <if test="dataSource != null">#{dataSource},</if>
            <if test="lastMonthStock != null">#{lastMonthStock},</if>
            <if test="sapBadQty != null">#{sapBadQty},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateCxMonthPlanSurplus" parameterType="com.zlt.aps.cx.engine.domain.CxEngineMonthPlanSurplus">
        update t_cx_month_plan_surplus
        <trim prefix="SET" suffixOverrides=",">
            <!--Joran 2021-07-28 更新计划修正量累加-->
            <if test="planModifyQty != null">plan_modify_qty=nvl(plan_modify_qty,0) + #{planModifyQty},</if>
            <if test="monthRemainQty != null">month_remain_qty=nvl(month_remain_qty,0) + #{monthRemainQty},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <update id="deleteMonthPlanSurplusByDataSource" parameterType="com.zlt.aps.cx.engine.domain.CxEngineMonthPlanSurplus">
        update t_cx_month_plan_surplus set del_flag='1'
        <where>
            data_source='1'
            and create_time between to_date(#{startTime},'yyyy-MM-dd hh24:mi:ss') and to_date(#{endTime},'yyyy-MM-dd hh24:mi:ss')
            <if test="sapCode != null and sapCode!=''">
                and sap_code=#{sapCode}
            </if>
        </where>
    </update>

    <!---Joran 2021-09-19 插单数据调量兼容更新start -->
    <update id="updateMonthPlanSurplusBySapCodeVersion" parameterType="com.zlt.aps.cx.engine.domain.CxEngineMonthPlanSurplus">
        update t_cx_month_plan_surplus
        <trim prefix="SET" suffixOverrides=",">
            <if test="updateInsertQty != null">
                plan_modify_qty=nvl(plan_modify_qty,0) + #{updateInsertQty},
                month_remain_qty=nvl(month_remain_qty,0) + #{updateInsertQty},
            </if>
        </trim>
        <where>
            del_flag='0'
            <if test="monthPlanApsVersion != null  and monthPlanApsVersion != ''"> and month_plan_aps_version = #{monthPlanApsVersion}</if>
            <if test="sapCode != null  and sapCode != ''"> and sap_code = #{sapCode}</if>
        </where>
    </update>
    <!---Joran 2021-09-19 插单数据调量兼容更新end -->


    </mapper>