<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.cx.engine.mapper.CxEngineSapSpecMoldUseMapper">
    <resultMap type="com.zlt.aps.cx.engine.domain.CxEngineSapSpecMoldUse" id="SapSpecMoldUseResult">
        <result property="id" column="id"/>
        <result property="sapCode" column="sap_code"/>
        <result property="embryoCode" column="embryo_code"/>
        <result property="specDesc" column="spec_desc"/>
        <result property="moldNum" column="mold_num"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectSapSpecMoldUseVo">
        select id, sap_code, embryo_code, spec_desc, mold_num, create_by, create_time, update_by, update_time, del_flag, remark from t_sap_spec_mold_use
    </sql>

    <select id="selectSapSpecMoldUseList" parameterType="com.zlt.aps.cx.engine.domain.CxEngineSapSpecMoldUse"
            resultMap="SapSpecMoldUseResult">
        <include refid="selectSapSpecMoldUseVo"/>
        <where>
             del_flag = '0'
            <if test="sapCode != null  and sapCode != ''">
                and instr(sap_code, #{sapCode})> 0
            </if>
            <if test="embryoCode != null  and embryoCode != ''">
                and instr(embryo_code #{embryoCode}) > 0
            </if>
        </where>

    </select>

    <select id="selectSapSpecMoldUseById" parameterType="Long" resultMap="SapSpecMoldUseResult">
        <include refid="selectSapSpecMoldUseVo"/>
        where id = #{id}
    </select>

</mapper>