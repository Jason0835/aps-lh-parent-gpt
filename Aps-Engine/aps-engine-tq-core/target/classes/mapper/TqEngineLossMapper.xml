<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.tq.engine.mapper.TqEngineLossMapper">

    <select id="listLossRate" parameterType="string" resultType="com.zlt.aps.tq.engine.vo.TqLossVo">
        select nvl(machine_id,'') || '#' || nvl(BEAD_CODE,'') LOSS_KEY, LOSS_RATE
        from T_TQ_LOSS_SETTING
        where DEL_FLAG = 0
    </select>

</mapper>
