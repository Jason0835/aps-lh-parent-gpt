<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.nc.engine.mapper.NcEngineLossMapper">

    <select id="listLossRate" parameterType="string" resultType="com.zlt.aps.nc.engine.vo.NcLossVo">
        select concat(IFNULL(machine_id,'') , '#' , IFNULL(lining_code,'')) LOSS_KEY, LOSS_RATE
        from T_NC_LOSS_SETTING
        where DEL_FLAG = 0
    </select>

</mapper>
