<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.nc.engine.mapper.NcEngineCurlRollMapper">

	<!-- 查询内衬卷曲设置列表 -->
    <select id="getNcCurlRollList" parameterType="string" resultType="com.zlt.aps.nc.api.domain.entity.NcCurlRoll">
        select id, lining_Code, curl_length
          from T_NC_CURL_ROLL
         where DEL_FLAG = 0
    </select>

</mapper>
