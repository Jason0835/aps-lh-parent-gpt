<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.mix.schedule.engine.mapper.MixingProductionModelEngineMapper">

    <select id="selectProductionModelList"
            resultType="com.zlt.mix.setting.api.domain.entity.MixingProductionModel">
        select * from t_mixing_production_model
        where DEL_FLAG = '0'
        and MIX_AREA = #{mixArea}
    </select>
</mapper>