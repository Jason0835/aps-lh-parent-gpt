<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.mix.schedule.engine.mapper.MixingGlueRecipeMapEngineMapper">

    <select id="selectGlueRecipeMapList"
            resultType="com.zlt.mix.setting.api.domain.entity.MixingGlueRecipeMap">
        select * from t_mixing_glue_recipe_map
        where DEL_FLAG = '0'
        and MIX_AREA = #{mixArea}
        <if test="reverseDayStockTag != null and reverseDayStockTag != ''">
            and REVERSE_DAY_STOCK_TAG = #{reverseDayStockTag}
        </if>
    </select>

</mapper>