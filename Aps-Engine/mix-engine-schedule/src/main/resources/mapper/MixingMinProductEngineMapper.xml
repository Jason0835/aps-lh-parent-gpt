<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.mix.schedule.engine.mapper.MixingMinProductEngineMapper">

    <select id="selectMixingMinProduct" resultType="com.zlt.mix.setting.api.domain.entity.MixingMinProduct">
        select glue, MIN_PRODUCT_STOCK
        from T_MIXING_MIN_PRODUCT
        where del_flag = '0'
          and mix_area = #{mixArea}
    </select>
</mapper>