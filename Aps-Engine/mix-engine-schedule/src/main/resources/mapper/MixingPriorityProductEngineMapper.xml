<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.mix.schedule.engine.mapper.MixingPriorityProductEngineMapper">

    <select id="selectMixingPriorityProduct"
            resultType="com.zlt.mix.setting.api.domain.entity.MixingPriorityProduct">
        select glue, PRIORITY_GLUE
        from t_mixing_priority_product
        where DEL_FLAG = '0'
          and MIX_AREA = #{mixArea}
    </select>
    
</mapper>