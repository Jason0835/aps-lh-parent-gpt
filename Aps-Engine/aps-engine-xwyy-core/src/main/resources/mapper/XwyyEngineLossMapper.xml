<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.xwyy.engine.mapper.XwyyEngineLossMapper">
	<!-- 查询 -->
    <select id="listLossRate" parameterType="string" resultType="com.zlt.aps.xwyy.engine.vo.XwyyLossSettingVo">
        SELECT nvl(machine_id,'') || '#' || nvl(big_roll_code,'') LOSS_KEY, /*组合key，机台id + 大卷编号*/
               LOSS_RATE
          FROM T_XWYY_LOSS_SETTING
         WHERE DEL_FLAG = 0
    </select>

</mapper>
