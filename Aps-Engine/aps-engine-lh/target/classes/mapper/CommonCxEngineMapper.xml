    <sql id="column">
        a.id, a.cx_batch_no, a.order_no, a.task_type, a.schedule_date, a.production_status, a.cx_machine_code, a.cx_machine_name,
        a.lh_machine_code, a.lh_machine_name, a.lh_machine_qty, a.minimum_lh_machine_req_qty, a.available_mold_qty,
        a.maximum_class_qty, a.work_shifts, a.storage_location, a.sap_code, a.spec_desc, a.embryo_code, a.lh_middle_night_finish_qty,a.bom_data_version,
        a.cx_month_finish_qty, a.reject_qty, a.newest_plan_qty,
        nvl(a.class3_planned_qty,0) class3_planned_qty,
        a.single_shift_lh_qty, a.total_stock,
        a.extended_stock, a.month_stock, a.actual_over_production, a.expected_over_production, a.difference_over_production,
        a.class1_available_lh_shift,
        nvl(a.class1_plan_qty,0) class1_plan_qty,
        a.class1_analysis_input,
        a.class1_analysis,
        a.class2_available_lh_shift,
        nvl(a.class2_plan_qty,0) class2_plan_qty,
        a.class2_analysis_input,
        a.class2_analysis,
        a.class3_available_lh_shift,
        nvl(a.class3_plan_qty,0) class3_plan_qty,
        a.class3_analysis, a.class4_available_lh_shift, a.class4_plan_qty, a.class4_analysis, a.class5_available_lh_shift,
        a.class5_plan_qty, a.class5_analysis, a.create_by, a.create_time, a.update_by, a.update_time, a.del_flag, a.remark,
        a.mark_close_out_tip, a.spec_dimension, a.is_release, a.class3_analysis_input, a.class4_analysis_input,
        a.class5_analysis_input, a.class1_sort, a.class2_sort, a.class3_sort, a.class4_sort, a.class5_sort,
        a.lh_machine_change_mold_desc,a.lh_single_tire_time
    </sql>

    <select id="selectCxScheduleResultList" parameterType="com.zlt.aps.cx.api.domain.entity.CxScheduleResult" resultMap="CxScheduleResultResult">
        select
        <include refid="column"/>
        from t_cx_schedule_result a
        <where>
            a.del_flag='0'
        <if test="taskType != null  and taskType != ''">and a.task_type = #{taskType}</if>
        <if test="scheduleDateStr != null and scheduleDateStr!='' ">and a.schedule_date = to_date(#{scheduleDateStr},'yyyy-MM-dd')</if>
        <if test="embryoCode != null  and embryoCode != ''">and a.embryo_code = #{embryoCode}</if>
        <if test="sapCode != null  and sapCode != ''">and a.SAP_CODE = #{sapCode}</if>
        <if test="productionStatus != null  and productionStatus != ''">and a.production_status = #{productionStatus}</if>
        <!--Joran 2021-10-04 查找符合条件的成型排程 start -->
        <if test="lhMachineCode!=null and lhMachineCode !=''">and instr(a.lh_machine_code,#{lhMachineCode}) > 0 </if>
        <if test="endTime !=null">
            <![CDATA[  and a.schedule_date <= to_date(#{endTime},'yyyy-MM-dd') ]]>
        </if>
        <if test="limit !=null and limit>0">
            <![CDATA[ and ROWNUM <= #{limit}]]>
        </if>
        </where>
        <if test="sortByScheduleDate !=null and sortByScheduleDate!=''">
            order by a.schedule_date ${sortByScheduleDate}
        </if>
        <!--Joran 2021-10-04 查找符合条件的成型排程 end -->
    </select>

    <!--根据排程日期查询抓取记录中的成型批次号-->
    <select id="selectCxBatchNoByScheduleDate" parameterType="String" resultType="string">
        select cx_batch_no from T_CX_AUTO_SCHEDULE_RECORD where schedule_date=to_date(#{scheduleDate},'yyyy-MM-dd') and status='0' and del_flag='0'
    </select>

    <sql id="selectCxStockVo">
        SELECT
            id,
            stock_date,
            embryo_code,
            bom_data_version,
            nvl(stock_num,0) stock_num,
            nvl(modify_num,0) modify_num,
            nvl(bad_num,0) bad_num,
            nvl(stock_num,0)+ nvl(modify_num,0)- nvl(bad_num,0) stock_real_num,
            create_by,
            create_time,
            update_by,
            update_time,
            del_flag,
            remark
        FROM
            t_cx_stock
    </sql>

    <select id="selectMergeCxStockList" parameterType="com.zlt.aps.cx.api.domain.entity.CxStock" resultType="com.zlt.aps.cx.api.domain.entity.CxStock">
        SELECT
            stock_date,
            embryo_code,
            sum(nvl(stock_num,0)+ nvl(modify_num,0)- nvl(bad_num,0)) stock_real_num
            FROM
            t_cx_stock
        <where>
            del_flag='0'
            <if test="stockDate != null "> and stock_date = #{stockDate}</if>
            <if test="stockDateStr != null and stockDateStr!='' "> and stock_date = to_date(#{stockDateStr},'yyyy-MM-dd')</if>
            <if test="embryoCode != null  and embryoCode != ''"> and embryo_code = #{embryoCode}</if>
        </where>
        group by stock_date,embryo_code
    </select>

    <select id="selectCxStockList" parameterType="com.zlt.aps.cx.api.domain.entity.CxStock" resultType="com.zlt.aps.cx.api.domain.entity.CxStock">
        <include refid="selectCxStockVo"/>
        <where>
            del_flag='0'
            <if test="stockDate != null "> and stock_date = #{stockDate}</if>
            <if test="stockDateStr != null and stockDateStr!='' "> and stock_date = to_date(#{stockDateStr},'yyyy-MM-dd')</if>
            <if test="embryoCode != null  and embryoCode != ''"> and embryo_code = #{embryoCode}</if>
            <if test="bomDataVersion != null  and bomDataVersion != ''"> and bom_data_version = #{bomDataVersion}</if>
            <if test="stockNum != null "> and stock_num = #{stockNum}</if>
            <if test="modifyNum != null "> and modify_num = #{modifyNum}</if>
            <if test="badNum != null "> and bad_num = #{badNum}</if>
        </where>
    </select>

    <!-- Joran 2021-10-05 查询成型参数-->
    <select id="selectCxParamsList" parameterType="com.zlt.aps.cx.api.domain.dto.CxParamsDto"  resultType="com.zlt.aps.cx.api.domain.dto.CxParamsDto">
        select t.param_code,t.param_value  from t_cx_params t
        <where>
            t.del_flag='0'
        </where>
    </select>

    <!--Joran 2022-06-10 获取成型机台任务的开始结束时间段-->
    <resultMap type="com.zlt.aps.lh.engine.domain.LhSapEmbryoTime" id="LhSapEmbryoTimeResult">
        <result property="sapCode"    column="sap_code"    />
        <result property="embryoCode"    column="embryo_code"    />
        <result property="bomDataVersion"    column="bom_data_version"    />
        <result property="cxMachineCode"    column="cx_machine_code"    />
        <result property="cxMachineName"    column="cx_machine_Name"    />
        <result property="cxOrderNo"    column="order_no"    />
        <result property="productOrder"    column="product_order"    />
        <result property="estimateStartTime"    column="estimate_start_time"    />
        <result property="estimateEndTime"    column="estimate_end_time"    />
    </resultMap>

    <select id="selectEmbryoTimeList" parameterType="String"  resultMap="LhSapEmbryoTimeResult">
       select
       csr.sap_code,
       csr.embryo_code,
       csr.bom_data_version,
       csr.cx_machine_code,
       csr.cx_machine_name,
       csr.order_no,
       stt.product_order,
       stt.estimate_start_time,
       stt.estimate_end_time
       from t_cx_schedule_result csr inner join t_cx_schedule_task_time stt on csr.order_no=stt.cx_order_no and stt.del_flag='0'
        <where>
            csr.del_flag='0'
            and csr.schedule_date=to_date(#{scheduleDate},'yyyy-MM-dd')
        </where>
       order by csr.embryo_code asc, stt.estimate_start_time asc
    </select>

</mapper>
