<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlt.aps.lh.engine.mapper.MoldEngineAutoGenerageRecordMapper">

    <resultMap type="com.zlt.aps.lh.engine.domain.MoldEngineAutoGenerageRecord" id="MoldEngineAutoGenerageRecordResult">
        <result property="id"    column="id"    />
        <result property="moldBatchNo"    column="mold_batch_no"    />
        <result property="cxBatchNo"    column="cx_batch_no"    />
        <result property="status"    column="status"    />
        <result property="generageDate"    column="generage_date"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectMoldEngineAutoGenerageRecordVo">
        select id, mold_batch_no, cx_batch_no, status, generage_date, create_by, create_time, update_by, update_time, del_flag, remark from t_mold_auto_generage_record
    </sql>

    <select id="selectMoldEngineAutoGenerageRecordList" parameterType="com.zlt.aps.lh.engine.domain.MoldEngineAutoGenerageRecord" resultMap="MoldEngineAutoGenerageRecordResult">
        <include refid="selectMoldEngineAutoGenerageRecordVo"/>
        <where>
            del_flag='0' and status ='0'
            <if test="moldBatchNo != null  and moldBatchNo != ''"> and mold_batch_no = #{moldBatchNo}</if>
            <if test="cxBatchNo != null  and cxBatchNo != ''"> and cx_batch_no = #{cxBatchNo}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="generageDate != null "> and generage_date = #{generageDate}</if>
            <if test="autoScheduleDate != null and autoScheduleDate!=''"> and generage_date = to_date(#{autoScheduleDate},'yyyy-MM-dd')</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectMoldEngineAutoGenerageRecordById" parameterType="Long" resultMap="MoldEngineAutoGenerageRecordResult">
        <include refid="selectMoldEngineAutoGenerageRecordVo"/>
        where id = #{id}
    </select>

    <insert id="insertMoldEngineAutoGenerageRecord" parameterType="com.zlt.aps.lh.engine.domain.MoldEngineAutoGenerageRecord">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT seq_mold_auto_generage_record.NEXTVAL as id FROM DUAL
        </selectKey>
        insert into t_mold_auto_generage_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="moldBatchNo != null">mold_batch_no,</if>
            <if test="cxBatchNo != null">cx_batch_no,</if>
            <if test="status != null">status,</if>
            <if test="generageDate != null">generage_date,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="moldBatchNo != null">#{moldBatchNo},</if>
            <if test="cxBatchNo != null">#{cxBatchNo},</if>
            <if test="status != null">#{status},</if>
            <if test="generageDate != null">#{generageDate},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateMoldEngineAutoGenerageRecord" parameterType="com.zlt.aps.lh.engine.domain.MoldEngineAutoGenerageRecord">
        update t_mold_auto_generage_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="moldBatchNo != null">mold_batch_no = #{moldBatchNo},</if>
            <if test="cxBatchNo != null">cx_batch_no = #{cxBatchNo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="generageDate != null">generage_date = #{generageDate},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMoldEngineAutoGenerageRecordById" parameterType="Long">
        update t_mold_auto_generage_record set del_flag='1' where id = #{id}
    </delete>

    <delete id="deleteMoldEngineAutoGenerageRecordByScheduleDate" parameterType="String">
        update t_mold_auto_generage_record set del_flag='1' where generage_date = to_date(#{scheduleDate},'yyyy-MM-dd')
    </delete>

    <delete id="deleteMoldEngineAutoGenerageRecordByIds" parameterType="String">
        update t_mold_auto_generage_record set del_flag='1' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>